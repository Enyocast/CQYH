Set VersionName=gmtool_

rmdir /s /q gmtool_r

md gmtool_r
md gmtool_r\bin
md gmtool_r\bin\config
md gmtool_r\bin\platforms


copy /v bin\config\gmtool_config.lua gmtool_r\bin\config
REN gmtool_r\bin\config\gmtool_config.lua config_template.lua


copy /v start-gmtool.bat gmtool_r
copy /V readme.txt gmtool_r

copy /v bin\qwindows.dll gmtool_r\bin\platforms
copy /v bin\icudt52.dll gmtool_r\bin
copy /v bin\icuin52.dll gmtool_r\bin
copy /v bin\icuuc52.dll gmtool_r\bin
copy /v bin\libEGL.dll gmtool_r\bin
copy /v bin\libGLESv2.dll gmtool_r\bin
copy /v bin\lua64.dll gmtool_r\bin
copy /v bin\msvcp120.dll gmtool_r\bin
copy /v bin\msvcr120.dll gmtool_r\bin
copy /v bin\Qt5Core.dll gmtool_r\bin
copy /v bin\Qt5Gui.dll gmtool_r\bin
copy /v bin\Qt5Widgets.dll gmtool_r\bin



IF NOT EXIST version ( md version )

copy /v gmtool\gmtool64.exe gmtool_r\bin

.\7z.exe a version\%VersionName%.zip .\gmtool_r

copy /v gmtool\gmtool64.pdb gmtool_r\bin

.\7z.exe a version\%VersionName%_s.zip .\gmtool_r

rmdir /s /q gmtool_r