<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup
    Condition="'$(toluapp_msgBeforeTargets)' == '' and '$(toluapp_msgAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <toluapp_msgBeforeTargets>Midl</toluapp_msgBeforeTargets>
    <toluapp_msgAfterTargets>CustomBuild</toluapp_msgAfterTargets>
  </PropertyGroup>
  <PropertyGroup>
    <toluapp_msgDependsOn
      Condition="'$(ConfigurationType)' != 'Makefile'">_SelectedFiles;$(toluapp_msgDependsOn)</toluapp_msgDependsOn>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <toluapp_msg>
      <CommandLineTemplate>script\toluappc.exe -D -c -a -n %(Filename) -o %(RootDir)%(Directory)tolua_%(Filename).cpp -H %(RootDir)%(Directory)tolua_%(Filename).h %(RootDir)%(Directory)%(Filename).pkg</CommandLineTemplate>
      <Outputs>%(RootDir)%(Directory)tolua_%(Filename).cpp</Outputs>
      <ExecutionDescription>Compiling tolua++ file %(Filename).pkg</ExecutionDescription>
      <ShowOnlyRuleProperties>false</ShowOnlyRuleProperties>
    </toluapp_msg>
  </ItemDefinitionGroup>
</Project>