<?xml version="1.0" encoding="utf-8"?>
<VisualStudioToolFile
	Name="toluapp_msg"
	Version="8.00"
	>
	<Rules>
		<CustomBuildRule
			Name="toluapp_msg"
			DisplayName="toluapp_msg"
			CommandLine="script\toluappc.exe -D -c -a -n $(InputName) -o $(InputDir)tolua_$(InputName).cpp -H $(InputDir)tolua_$(InputName).h $(InputDir)$(InputName).pkg"
			Outputs="$(InputDir)tolua_$(InputName).cpp"
			FileExtensions="*.pkg"
			ExecutionDescription="Compiling tolua++ file $(InputName).pkg"
			ShowOnlyRuleProperties="false"
			>
			<Properties>
			</Properties>
		</CustomBuildRule>
	</Rules>
</VisualStudioToolFile>
