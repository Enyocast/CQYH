[screen]
;Screen state: 1 = normal (igwScreenNormal); 2 = minimized (igwScreenMini)
;status=
;Immovable windows: login, security token verification, security card verification, and default toolbar
;nomovewindow=igwUserLoginDialog;igwUserLoginEKeyDialog;igwUserLoginECardDialog;taskbarsvertical

;Default toolbar
[toolbar1]
;Toolbar name (do not change)
;This window name can be used with GetWinProperty and SetWinProperty to read or change its state and position
name=UserMainBar
;UI description file location (do not change)
xul=XMLUI\DefaultTaskBarAutoV.xml
;Width
;width=
;Height
;height=
;Left-aligned position
;left=
;Top-aligned position
top=100
;Right-aligned position
right=60
;Bottom-aligned position
;bottom=
;Toolbar visibility: 1 = visible; 0 = hidden before login
;When hidden before login, call SetScreenStatus after successful login to show the toolbar; it becomes visible automatically after a delay if not called
;show=1