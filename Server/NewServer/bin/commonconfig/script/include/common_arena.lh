--Current arena state
ARENA_STAGE_VAR_INDEX = 1;

--Arena preparation duration
ARENA_INIT_DURATION = 60 * 1000;

--Wait duration after the arena ends
ARENA_CLOSE_WAIT_DURATION = 1 * 60 * 1000;

--Maximum arena open duration
ARENA_MAX_DURATION = 5 * 60 * 1000;

--Scene variable for server time when the arena starts
ARENA_START_TIME_VAR_INDEX = 2;

--Scene variable for opening the arena door
ARENA_DOOR_TOGGLE_VAR_INDEX = 4;