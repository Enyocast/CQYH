ESCORT_ALREADY_DEAD = 1;                             -- Escort cart is dead


--
-- Generate escort cart configuration
--
-- id: escort cart template ID
-- Probability range [1, 10000]; all entry bounds must fall within this range
-- prop_low: lower probability bound (inclusive)
-- prop_up: lower probability bound (inclusive)
-- coeff: escort cart coefficient
-- accept_base_money_cost: base gold cost to accept an escort
-- accept_base_bg_cost: base guild contribution cost to accept an escort
-- award_multi: reward multiplier (multiple of the deposit)
ESCORT_CAR_INFO_TABLE = 
{
    {
	id = 6110,             
	prop_low = 1,
	prop_up = 9000,   
	coeff = 1,
	accept_base_money_cost = ESCORT_ACCEPT_BASE_MONEY,
	accept_base_bg_cost = ESCORT_ACCEPT_BASE_BG,
	accept_base_item_id = ESCORT_ACCEPT_BASE_ITEM_A,
	award_item = 1,
	award_multi = 2;     
    },
    {
	id = 6131,       
	prop_low = 9001,
	prop_up = 10000,  
	coeff = 2,
	accept_base_money_cost = ESCORT_ACCEPT_BASE_MONEY,    
	accept_base_bg_cost = ESCORT_ACCEPT_BASE_BG,  
	accept_base_item_id = ESCORT_ACCEPT_BASE_ITEM_S,
	award_item = 1,
	award_multi = 3;     
    },
    {
	id = 6131,       
	prop_low = 9001,
	prop_up = 10000,  
	coeff = 2,
	accept_base_money_cost = ESCORT_ACCEPT_BASE_MONEY,    
	accept_base_bg_cost = ESCORT_ACCEPT_BASE_BG,  
	accept_base_item_id = ESCORT_ACCEPT_BASE_ITEM_SS,
	award_item = 1,
	award_multi = 4;     
    },

};

function find_escort_car_info(car_id)
    for _,v in ipairs(ESCORT_CAR_INFO_TABLE) do
        if v.id == car_id then
            return v;
        end
    end

    return nil;
end

function random_car_info(item_id)
   -- local prop_value = math.random(1, 10000);
    for _,v in ipairs(ESCORT_CAR_INFO_TABLE) do
        if v.accept_base_item_id == item_id then
            return v;
        end
    end

    return nil;
end

function cal_accept_escort_cost(baseCost, guildBuildingLevel)

    rInt, rFra = math.modf(baseCost * ( 10 + (guildBuildingLevel - 1)) / 10);
	return rInt;
end
