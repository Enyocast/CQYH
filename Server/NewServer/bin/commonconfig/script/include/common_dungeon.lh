--Current dungeon state
DUNGEON_STAGE_VAR_INDEX = 1;

--Dungeon initialization duration
DUNGEON_INIT_DURATION = 2 * 1000;

--Wait duration after the dungeon ends
DUNGEON_FINISH_WAIT_DURATION = 5 * 1 * 1000;

--Dungeon reward claim duration
DUNGEON_REWARD_WAIT_DURATION = 1 * 60 * 1000;

--Wait after the dungeon ends; must exceed DUNGEON_FINISH_WAIT_DURATION + DUNGEON_REWARD_WAIT_DURATION.
DUNGEON_CLOSE_WAIT_DURATION = 2 * 60 * 1000;

--Maximum dungeon duration
DUNGEON_MAX_DURATION = 200 * 60 * 1000;