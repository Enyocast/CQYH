	-- strAI6671
	{ enum = "strAI6671_1", str = "<#D>目前我能捆的有卷书和各种药水。你要捆吗？要捆东西得给我金币。<#D/><#SO:1>捆普通药水<#SO/><#SO:2>捆高级药水<#SO/><#SO:3>捆卷书<#SO/>"},
	{ enum = "strAI6671_2", str = "<#D>请选择你要捆的高级药水类型。<#D/><#SO:1>捆太阳水（200金币）<#SO/><#SO:2>捆强效太阳水（500金币）<#SO/><#SO:3>捆疗伤药（1000金币）<#SO/><#SO:4>返回<#SO/>"},
	{ enum = "strAI6671_4", str = "<#D>请选择你要捆的卷书类型。每种都需要100金币。<#D/><#SO:1>捆比奇回城卷<#SO/><#SO:2>捆盟重回城卷<#SO/><#SO:3>捆随机传送卷<#SO/><#SO:4>返回<#SO/>"},
