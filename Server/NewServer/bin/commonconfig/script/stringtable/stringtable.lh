	-- strAI6163
	{ enum = "strAI6163_6_1", str = "公会据点战结束后两小时可以在我这里领取奖励。"},
	{ enum = "strAI6163_6_2", str = "成功占领据点的公会所有成员可以领取状态奖励，该状态提高经验倍率。长老以上职位玩家可以领取限时称号（最多6个）。<#D/><#SO:1>我要领取状态<#SO/><#SO:2>我要领取称号<#SO/>"},
	{ enum = "strAI6163_6_3", str = "非占领公会会员不能领取奖励。"},


	-- strAI_6112
	{ enum = "strAI_6112_1", str = "任何达到20级的勇士均可进入九层妖塔进行试炼，你准备好了吗，年轻人？<#SO:1>确定进入<#SO/><#INS:S25>关于九层妖塔<#INS/><#SO:2>取消<#SO/>"},
	
	
	-- strAI_4795
	{ enum = "strAI_4795_1", str = "每周一、三、五的21点，等级达到22级的勇士，都可进入武斗场1小时，每次进入需要花费10000金币。<#SO:1>确认进入（花费10000金币）<#SO/><#SO:2>取消<#SO/>"},
	
	-- strAI_6101
