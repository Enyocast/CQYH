	{ enum = "strAI6151_1", str = "我知道一条通往[幽冥海三层]的秘密通道，不过只有等级达到35级的勇士才能通过，想不想去？<#SO:1>送我去[幽冥海三层]<#SO/><#SO:2>取消<#SO/>" },
