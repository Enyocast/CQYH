	-- strAI6147
	{ enum = "strAI6147_1", str = "我知道一条通往[死亡峡谷六层]的秘密通道，想去吗？不过大家有财一起发，给我金币我立刻送你过去，如何？<#SO:1>传送自己去[死亡峡谷六层]<#SO/><#SO:2>传送队伍去[死亡峡谷六层]<#SO/>" },
	{ enum = "strAI6147_2", str = "[死亡峡谷六层]魔怪众多，没两把刷子可不要去送死，你真的想给我1万金币让我送你过去吗？<#SO:1>确认花费1万金币单人传送<#SO/>" },
	{ enum = "strAI6147_3", str = "没钱可不行，1万金币一个子儿也不能少！" },
	{ enum = "strAI6147_4", str = "[死亡峡谷六层]魔怪众多，没两把刷子可不要去送死，我会把当前场景里你队伍里的所有成员都传送过去。你真的想给我10万金币让我传送吗？<#SO:1>确认花费10万金币队伍传送<#SO/>" },
