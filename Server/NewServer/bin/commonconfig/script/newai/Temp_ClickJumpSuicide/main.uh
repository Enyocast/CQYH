
function _suicide()
    if d.nParam[7] == 0 then
        return nil;
    else
        return { batSuicide, param = { 0 } };
    end
end

evtAIInteract = 
{ batSequencer,
    __check_cd_timer(COOLDOWN_AI, JUMP_CD_TIMER, d.nParam[6]),
    __set_cd_timer(COOLDOWN_AI, JUMP_CD_TIMER, d.nParam[6]),
    { batPlayAction, param = { d.nParam[4] } },
    { batSay, param = { d.nParam[5] } },
    { batWait, param = { 500 } },
    { batRoleTeleport, param = { d.nParam[1], d.nParam[2], d.nParam[3], d.nParam[0] } },
    _suicide(),
};
