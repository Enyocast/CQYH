}; 

on_init =
{ batSequencer,
   { batSetCDTimer , param={ COOLDOWN_AI ,SAY_TEXT_CD_TIMER,d.nParam[0],d.nParam[0]+20000},
    },
};


on_wander = 
{ batSequencer,
    { batCheckCDTimer, param={ COOLDOWN_AI , SAY_TEXT_CD_TIMER},
    },
    { batSetCDTimer , param={ COOLDOWN_AI ,SAY_TEXT_CD_TIMER,d.nParam[0],d.nParam[0]+20000},
    },
    _random_action(),
};