					{ batRepeat, param = { 30 },
						{ batSequencer,
							{ batRoleOpenDialog, param = { strAI6671_2, 50000, 0, 0 } },	

							{ batSelector,
								{ batSequencer, 
									{ batRoleCheckInteractOption, param = { 1 } },
									--Option: sun potion, bind potion IDs 351 to 381
									_tie_potions(351,381,200,MONEYLOG_BT_15),
								},
								{ batSequencer, 
									{ batRoleCheckInteractOption, param = { 2 } },
									--Option: potent sun potion, bind potion IDs 352 to 382
									_tie_potions(352,382,500,MONEYLOG_BT_16),
								},	
									--Option: bind healing medicine 2000
