				{ batRoleCheckInteractOption, param = { 3 } },
				{ batParallel,
					{ batRepeat, param = { 30 },
						{ batSequencer,
							{ batRoleOpenDialog, param = { strAI6671_4, 50000, 0, 0 } },	

							{ batSelector,
								{ batSequencer, 
									{ batRoleCheckInteractOption, param = { 1 } },
