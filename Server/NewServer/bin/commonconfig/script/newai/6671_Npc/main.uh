--On successful bundling, show a confirmation dialog with a return option
function _tie_success()
		local tie_table = 
		 { batSequencer,
		 	{ batRoleOpenDialog, param = { 666508, 50000, 0, 0 } },
 			{ batRoleCheckInteractOption, param = { 1 } },
		 };
		return tie_table;
end

--Attempt to bundle potions
function _tie_potions(potions_1,potions_2,price,moneytype)
		local tie_table = 

		{ batSelector,
			{ batSelector,

				{ batSequencer,
					{ batRoleCheckLevel , param = { boGTE, 36 } },
					{ batRoleCheckLevel , param = { boLT, 99 } },
					{ batRoleCheckRoleVariable , param = { boGTE, 211, 250, 0 } },
					{ batRoleOpenDialog, param = { strAI6671_5, 50000, 0, 0 } },
				},

				{ batSequencer,
					{ batRoleCheckLevel , param = { boGTE, 21 } },
					{ batRoleCheckLevel , param = { boLT, 36 } },
					{ batRoleCheckRoleVariable , param = { boGTE, 211, 200, 0 } },
					{ batRoleOpenDialog, param = { strAI6671_5, 50000, 0, 0 } },
				},

				{ batSequencer,
					{ batRoleCheckLevel , param = { boGTE, 15 } },
					{ batRoleCheckLevel , param = { boLT, 21 } },
					{ batRoleCheckRoleVariable , param = { boGTE, 211, 100, 0 } },
					{ batRoleOpenDialog, param = { strAI6671_5, 50000, 0, 0 } },
				},


				{ batSequencer,					
					{ batRoleCheckLevel , param = { boGTE, 1 } },
					{ batRoleCheckLevel , param = { boLT, 15 } },
					{ batRoleCheckRoleVariable , param = { boGTE, 211, 0, 0 } },
					{ batRoleOpenDialog, param = { strAI6671_5, 50000, 0, 0 } },
				},
			},

			{ batSelector,
				--Check whether there are enough potions
				{ batSequencer, 
					{ batRoleCheckItemCount, param = { boGTE,potions_1, 6 } },
					{ batSelector,
						{ batSequencer, 
							--Check funds; if sufficient, deduct money and items and exchange the items
							{ batRoleCheckMoney , param = { boGTE,1, price } },
							{ batRoleSubMoney , param = { tarRole,1, price, moneytype } },
							{ batRoleDelItem, param = { potions_1, 6 } },
							{ batRoleAddItem , param = { potions_2, 1, 6 } },
							--Bundling success message
							{ batRoleSetRoleVariable , param = { 211, 0, 1 } },
							_tie_success(),
						},
						{ batSequencer, 
							--Report insufficient money, e.g. price = 100 gold
							{ batRoleOpenDialog, param = { 666507, 50000, 0, 0 } },
						},
					},

				},
				--Not enough potions
				{ batSequencer, 
					{ batRoleOpenDialog, param = { 666505, 50000, 0, 0 } },
				},
        	},

		};


		return tie_table;
end

--Attempt to bundle scrolls
function _tie_scrolls(scroll_1,scroll_2,price,moneytype)
		local tie_table = 
		{ batSelector,
			--Check whether there are enough scrolls
			{ batSequencer, 
				{ batRoleCheckItemCount, param = { boGTE,scroll_1, 6 } },
				{ batSelector,
					{ batSequencer, 
						--Check funds; if sufficient, deduct money and items and exchange the items
						{ batRoleCheckMoney , param = { boGTE,1, price } },
						{ batRoleSubMoney , param = { tarRole,1, price, moneytype } },
						{ batRoleDelItem, param = { scroll_1, 6 } },
						{ batRoleAddItem , param = { scroll_2, 1, 6 } },
						--Bundling success message
						_tie_success(),
					},
					{ batSequencer, 
						--Report insufficient money, e.g. price = 100 gold
						{ batRoleOpenDialog, param = { 666507, 50000, 0, 0 } },
					},
				},

			},
			--Report insufficient scrolls
			{ batSequencer, 
				{ batRoleOpenDialog, param = { 666506, 50000, 0, 0 } },
			},
        };
		return tie_table;
end

function _random_action()
    local action_table = {};
    local count = 0;
    if d.nParam[1] ~= 0 then
        count = count + 1;
        table.insert(action_table,
            { batParallel,
                { batSay, param = { cctScreen, d.nParam[1], cltNormal } },
            }
        );
    end
    if d.nParam[2] ~= 0 then
        count = count + 1;
        table.insert(action_table,
            { batParallel,
                { batSay, param = { cctScreen, d.nParam[2], cltNormal } },
            }
        );
    end
    if d.nParam[3] ~= 0 then
        count = count + 1;
        table.insert(action_table,
            { batParallel,
                { batSay, param = { cctScreen, d.nParam[3], cltNormal } },
            }
        );
    end

    if count == 1 then
        return action_table;
    elseif count == 2 then
        return 
        { batRandom, param = { 1, 1 }, 
            unpack(action_table)
        };
    elseif count == 3 then
        return 
        { batRandom, param = { 1, 1, 1 }, 
            unpack(action_table)
        };
    else
        return nil;
    end
end

evtAIInteract = 
{ batRepeat, param = { 30 },
	{ batSequencer,

