on_init = 
	{ batSequencer, 
	  { batSetCDTimer, param = { COOLDOWN_AI, 20, d.nParam[0] } },  --Cooldown index 20 configures boss idle suicide using param0; in-combat suicide uses livetime
	  { batSetAlwaysRun , param = { true } },
	};

on_wander = 
	{ batSequencer, 
		{ batCheckCDTimer, param = { COOLDOWN_AI, 20 } },
		--{ batSay, param = { cctScreen, 50568, cltNormal } },
		{ batSuicide, param = { false, false } },
	};

on_cast_spell = 
{ batSequencer,
	{ batSelector,
        { batSequencer,
		    { batCheckBossState , param = { 0 } },
		    { batCheckCharHp , param = { tarSelf , boLTE , 6000 } },
				{ batSequencer,
				{ batPlayAction , param = { 1 } },
					   { batRandom , param = { 25 , 25 , 25 , 25 },
							{ batTeleportTo  , param = { 15600 , 36800 , 30000 } },
							{ batTeleportTo  , param = { 17800 , 37500 , 30000 } },
							{ batTeleportTo  , param = { 17700 , 41900 , 30000 } },
							{ batTeleportTo  , param = { 15700 , 41800 , 30000 } },
					   },
					   { batSetBossState , param = { 1 } },
				},
		}, 		
        { batSequencer,
		    { batCheckBossState , param = { 1 } },
		    { batCheckCharHp , param = { tarSelf , boLTE  , 4000 } },
			{ batSequencer,
			   { batPlayAction , param = { 1 } },
			   { batRandom , param = { 25 , 25 , 25 , 25 },
					{ batTeleportTo  , param = { 16800 , 36500 , 30000 } },
					{ batTeleportTo  , param = { 16700 , 42100 , 30000 } },
					{ batTeleportTo  , param = { 18300 , 39300 , 30000 } },
					{ batTeleportTo  , param = { 15200 , 39200 , 30000 } },
			   },
			   { batSetBossState , param = { 2 } },
			},
		}, 	
        { batSequencer,
		    { batCheckBossState , param = { 2 } },
		    { batCheckCharHp , param = { tarSelf , boLTE  , 3000 } },		   
			{ batSequencer,
			   { batPlayAction , param = { 1 } },
			   { batRandom , param = { 25 , 25 , 25 , 25 },
					{ batTeleportTo  , param = { 15600 , 36800 , 30000 } },
					{ batTeleportTo  , param = { 17800 , 37500 , 30000 } },
					{ batTeleportTo  , param = { 17700 , 41900 , 30000 } },
					{ batTeleportTo  , param = { 15700 , 41800 , 30000 } },
			   },
			   { batSetBossState , param = { 3 } },
			},		  
		}, 		
	}, 
};