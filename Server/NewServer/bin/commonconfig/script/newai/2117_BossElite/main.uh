local spell_common =
{
	{ id = 5660, cd = 3000, chance = 10000, target = tarAITarget },    --1. Ghost Ship whale-man leader: wide melee strike, adjusting the two-hit combo to random left/right strikes in a forward U-shaped area 2-3 cells deep
	{ id = 5662, cd = 25000, chance = 10000, target = tarAITarget },   --2. Ghost Ship whale-man leader: fast-moving area attack; increases physical and magic defense while active and damages a 7x7 area
	{ id = 5666, cd = 0, chance = 10000, target = tarAITarget },       --3. Ghost Ship whale-man leader: consecutive single-target throws, high damage and weapon durability damage (MaxGrid=5)
	{ id = 5664, cd = 0, chance = 10000, target = tarAITarget },       --4. Ghost Ship whale-man leader: consecutive single-target throws, high damage and armor durability damage (MaxGrid=5)
	{ id = 5665, cd = 0, chance = 10000, target = tarAITarget },       --5. Ghost Ship whale-man leader: powerful close-range magic AOE extending forward in three stages
};


on_wander = 
{ batSequencer,
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[2].id, spell_common[2].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[3].id, spell_common[3].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[4].id, spell_common[4].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[5].id, spell_common[5].cd);
};

on_cast_spell =
{ batSelector,
	__cast_spell(spell_common[1].id, tarAITarget, spell_common[1].chance, spell_common[1].cd);
	__cast_spell(spell_common[2].id, tarAITarget, spell_common[2].chance, spell_common[2].cd);
	{ batSequencer,
	    { batCheckCDTimer , param = { COOLDOWN_AI , 100 },},
	    { batRandom, param = { 5000, 5000 },
		    __cast_spell(spell_common[3].id, tarAITarget, spell_common[3].chance, spell_common[3].cd);
		    __cast_spell(spell_common[4].id, tarAITarget, spell_common[4].chance, spell_common[4].cd);
	    },
		{ batSetCDTimer, param = { COOLDOWN_AI , 100 , 20000},},
	},
	{ batSequencer,
		{ batCheckCharHp , param = { tarSelf, boLTE, 9000 } },	
		{ batCheckCDTimer , param = { COOLDOWN_AI , 99 },},
		__cast_spell(spell_common[5].id, tarAITarget, spell_common[5].chance, spell_common[5].cd);
        { batSetCDTimer, param = { COOLDOWN_AI , 99 , 30000},},		
	},
};






