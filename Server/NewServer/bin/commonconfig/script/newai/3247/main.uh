LoadPackage("drop_generator.pkg")
LoadPackage("npc.pkg")
LoadPackage("scene.pkg")

function OnBossDie(owner, p1, p2, p3, p4)
	local scene = owner:GetScene();
	if scene == nil then
		return brvError;
	end

	local var = scene:GetVariable(30);
	local boss_count = scene:GetVariable(31);
	print("zhaocaijinzhu DIE!");
	if var >= 100 and boss_count < 10 then
		local res = scene:SpawnNpc(5375,  owner:GetX(), owner:GetY(), owner:GetZ(), 0,  0, nil);
		if res ~= nil then
			scene:SetVariable(30, 0);
			scene:SetVariable(31, boss_count + 1);
		end
	end
	print("zhaocaijinzhu DIE!");
	local gen = CDropGenerator:GetInstance();
	local index = math.random(1,3);
	for i = 1, index do
		gen:GenerateDrop(scene:GetServerGroup(), 2800361, 1, scene, owner:GetX(), owner:GetY(), owner:GetZ(), owner:GetObjID(), true);
	end
	
	return brvSuccess;
end

on_die =
{ batSequencer,
	{ batCheckDateTime, param = { 0, 200001, 220000  } },
	{ batCheckSceneVariable, param={ boLT,31, 10 } },
	{ batCheckSceneVariable, param={ boLT,31, 10 } },
	{ batSetSceneVariable , param={ 30, 0, 1 } },
	{ OnBossDie, param = { 0, 0, 0, 0} },
	
};



