--Character collection event
function _item_collection(collection_reward,collection_check_table)
	local _collection_table = 
	{ batSelector,
		{batSequencer,
			{ batRoleCheckInteractOption, param = { 2 } },
			{ batSelector,
				{batSequencer,
					{ batRoleCheckItemCount, param = { boGTE,collection_check_table[1], 1 } }, 
					{ batRoleCheckItemCount, param = { boGTE,collection_check_table[2], 1 } }, 
					{ batRoleCheckItemCount, param = { boGTE,collection_check_table[3], 1 } }, 
					{ batRoleCheckItemCount, param = { boGTE,collection_check_table[4], 1 } }, 
					{ batRoleCheckItemCount, param = { boGTE,collection_check_table[5], 1 } }, 
					{ batRoleCheckItemCount, param = { boGTE,collection_check_table[6], 1 } }, 
					{ batParallel,
						{ batRoleDelItem, param = { collection_check_table[1], 1 } },
						{ batRoleDelItem, param = { collection_check_table[2], 1 } },
						{ batRoleDelItem, param = { collection_check_table[3], 1 } },
						{ batRoleDelItem, param = { collection_check_table[4], 1 } },
						{ batRoleDelItem, param = { collection_check_table[5], 1 } },
						{ batRoleDelItem, param = { collection_check_table[6], 1 } },
					},
					{ batRoleAddItem, param = { collection_reward, 1 } },	
					{ batRoleOpenDialog, param = { 479113, 50000, 0, 0 } },		
				},
				{batSequencer,
					{ batRoleOpenDialog, param = { 479114, 50000, 0, 0 } },
				},
			},
		},
		{batSequencer,
			{ batRoleOpenDialog, param = { 479115, 50000, 0, 0 } },
		},		

	};
	return _collection_table;
end


