on_enter_fight =
{ batSequencer, 
    { batSetCDTimer, param = { COOLDOWN_AI, 9, 5000 } },
};

on_chase = 
{ batSequencer,
	{ batCheckCanCastSpell },
	__check_cd_timer(COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime),
	{ batSelector, 
		{ batSequencer,
		    { batCheckCDTimer, param = { COOLDOWN_AI, 9 } },
			{ batSyncCastSpellToTarget, param = { 5861, tarAITarget } },		
			{ batSetCDTimer, param = { COOLDOWN_AI, 9, 20000 } },
			{ batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },	
    },
};

on_cast_spell = 
{ batSequencer,
	{ batCheckCanCastSpell },
	__check_cd_timer(COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime),
	{ batSelector, 
		{ batSequencer,
			{ batCheckCharHp , param = { tarSelf, boLTE, 9000 } },	
		    { batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
			{ batSyncCastSpellToTarget, param = { 5595, tarSelf } },		
			{ batSetCDTimer, param = { COOLDOWN_AI, 10, 30000 } },
			{ batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },
        { batSequencer,
		    { batCheckCDTimer, param = { COOLDOWN_AI, 9 } },
			{ batSyncCastSpellToTarget, param = { 5861, tarAITarget } },		
			{ batSetCDTimer, param = { COOLDOWN_AI, 9, 20000 } },
			{ batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },			
    },
};







