local spell_common =
{
	{ id = 3766, cd = 2500, chance = 10000, target = tarAITarget },         --Evil Claw Worm - Flail: hops and strikes targets in front, damaging and knocking them back at medium range
	{ id = 3773, cd = 10000, chance = 10000, target = tarAITarget },        --Evil Claw Worm - Magic Release: releases accumulated magical energy
	{ id = 3769, cd = 15000, chance = 10000, target = tarAITarget },        --Evil Claw Worm - Foul Breath: shakes its tail to create a persistent contaminated area that silences entrants; the cloud may drift
	{ id = 3770, cd = 16000, chance = 10000, target = tarAITarget },        --Evil Claw Worm - Crushing Bite: after a long wind-up, bites and repeatedly tears the target while recovering HP
	{ id = 3771, cd = 25000, chance = 7000, target = tarAITarget },         --Evil Claw Worm - Poison Creation: fires venom at a target, causing it to continuously damage and poison nearby units
	{ id = 3772, cd = 45000, chance = 10000, target = tarSelf },            --Evil Claw Worm - Tank Charge: receives a buff that prevents skill use but allows movement, causing nearby aftershocks
};

on_cast_spell =
{ batSelector,
    __cast_spell(spell_common[1].id, spell_common[1].target, spell_common[1].chance, spell_common[1].cd); 
    __cast_spell(spell_common[2].id, spell_common[2].target, spell_common[2].chance, spell_common[2].cd); 
    __cast_spell(spell_common[3].id, spell_common[3].target, spell_common[3].chance, spell_common[3].cd); 
    __cast_spell(spell_common[4].id, spell_common[4].target, spell_common[4].chance, spell_common[4].cd); 
    __cast_spell(spell_common[5].id, spell_common[5].target, spell_common[5].chance, spell_common[5].cd); 
};