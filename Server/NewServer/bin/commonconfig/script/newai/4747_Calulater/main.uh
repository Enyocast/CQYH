on_init =
{batSequencer,
    { batSetSceneVariable, param={1, 0 },},
    { batSetSceneVariable, param={3, 0 },},
    { batSetSceneVariable, param={3, 0 },},
    { batSetSceneVariable, param={5, 0 },},
    { batSetSceneVariable, param={7, 0 },},
};

on_wander = 
{batParallel ,
    {batSequencer, --记录已战斗的回合数
        { batCheckSceneVariable, param={ boEQ , 2, 1 },},

        { batSetSceneVariable, param={ 3, 0,1},},
        { batSetSceneVariable, param={ 2, 2 },},
    },
    {batSequencer,--记录玩家（僵尸）赢得的回合数
        { batCheckSceneVariable, param={ boEQ , 4, 1 },},
        { batSetSceneVariable, param={ 5, 0,1},},
        { batCheckSceneVariable, param={ boEQ , 4, 0 },},
    },
    {batSequencer,--记录植物赢得的回合数
        { batCheckSceneVariable, param={ boEQ , 6, 1 },},
        { batSetSceneVariable, param={ 7, 0,1},},
        { batCheckSceneVariable, param={ boEQ , 6, 0 },},
    },
    {batSequencer,
        { batCheckSceneVariable, param={ boGTE, 3,3 },},
        { batCheckCDTimer, param={ COOLDOWN_AI , 5},
        },
        { batSetCDTimer , param={ COOLDOWN_AI , 5,30000},
        },
        
        { batWait, param={60000},
        },
        {batSuicide},
    },

};