function OnBossDie(owner, p1, p2, p3, p4)
	local scene = owner:GetScene();
	if scene == nil then
		return brvError;
	end
	local gen = CDropGenerator:GetInstance();
	index = math.random(70,120);
	for i = 1, index do
		gen:GenerateDrop(scene:GetServerGroup(), 2800357, 10, scene, owner:GetX(), owner:GetY(), owner:GetZ(), owner:GetObjID(), false);
	end
	return brvSuccess;
end

on_die =
{ batSequencer,
	{ OnBossDie, param = { 0, 0, 0, 0} },
	{ batSay, param={ cctScene, str2021newyearBOSS }},
	 
};






