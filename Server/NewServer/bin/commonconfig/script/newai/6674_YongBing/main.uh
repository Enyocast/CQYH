on_init =
{ batSequencer ,
    { batSetSceneVariable, param = { 3, 0 },},
    { batSetAlwaysRun, param = { 1 } },
};  

on_wander =
{ batSequencer, 
	{ batCheckSceneVariable, param = { boEQ, 3, 1 },},
    { batCheckCDTimer , param = { COOLDOWN_AI , 100 },},
    { batSetCDTimer, param = { COOLDOWN_AI , 100 , 5000},},
    { batMoveTo, param = {tarPosition , 90850, 42797 , d.nWalkSpeed * 1000 / GAME_FPS },},
    { batWait, param={3000},},
	{ batSuicide },
	{ batSummonNpc, param= { 807 },},
};