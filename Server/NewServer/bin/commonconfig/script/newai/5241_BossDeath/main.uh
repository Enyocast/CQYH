				{ batSyncCastSpellToTarget, param = { 5713, tarAITarget } },
				{ batSyncCastSpellToTarget, param = { 5713, tarAITarget } },
				--Normal slash
				{ batWait, param={ 500 }},
				{ batRandom, param = { 6000, 4000 },
					{ batSyncCastSpellToTarget, param = { 5713, tarAITarget } },
