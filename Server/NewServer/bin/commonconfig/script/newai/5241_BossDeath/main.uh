				{ batWait, param={ 1400 }},
				{ batSyncCastSpellToTarget, param = { 5719, tarAITarget } },
				{ batWait, param={ 1400 }},
				{ batSyncCastSpellToTarget, param = { 5719, tarAITarget } },
				--Tornado
				{ batSyncCastSpellToTarget, param = { 5714, tarAITarget } },
				{ batSetCDTimer, param = { COOLDOWN_AI, 14, 12000 } },
			},
			{ batSequencer,
				{ batCheckCDTimer, param = { COOLDOWN_AI, 4 } },
				{ batCheckCanCastSpell },
				--Normal slash
				{ batSyncCastSpellToTarget, param = { 5713, tarAITarget } },
				{ batWait, param={ 800 }},
				{ batSyncCastSpellToTarget, param = { 5713, tarAITarget } },
				{ batSyncCastSpellToTarget, param = { 5713, tarAITarget } },
				--Ghost Rush: releases many ghosts from the hands to attack players
				{ batSyncCastSpellToTarget, param = { 5716, tarSelf } },
				{ batSyncCastSpellToTarget, param = { 5717, tarAITarget } },
				{ batWait, param={ 1000 }},
				{ batSetCDTimer, param = { COOLDOWN_AI, 4, 10000 } },
			},
		},
	},
	{ batSequencer,
		{ batCheckCharHp, param = { tarSelf,boLT,3000} },
		{ batSelector,
			{ batSequencer,
				{ batCheckCDTimer, param = { COOLDOWN_AI, 17 } },
				{ batCheckCanCastSpell },
				--Reaper - Soul Pierce: a shriek creates an area shockwave that immediately stuns stationary targets; if they do not break free, cast Life Drain (4-30)
				{ batSyncCastSpellToTarget, param = {5458, tarAITarget } },
