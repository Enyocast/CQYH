--Skill configuration
on_cast_spell = 
{ batSelector,
	{ batSequencer,
		{ batCheckCharHp , param = { tarSelf ,boGTE,6000} },
		{ batSelector,
			{ batSequencer,
				{ batCheckCDTimer, param = { COOLDOWN_AI, 8 } },
				{ batCheckCanCastSpell },
				--Reaper - Eye-Pecking Raven: spreads its wings and fires a shadow raven shockwave forward, blinding targets for 2 seconds and inflicting bleeding
				{ batSyncCastSpellToTarget, param = { 5722, tarAITarget } },
				{ batWait, param={ 1000 }},
				--Reaper - Undead Form: transforms and strikes targets in range with a life-stealing pierce
				{ batSyncCastSpellToTarget, param = { 5718, tarAITarget } },
				{ batSyncCastSpellToTarget, param = { 5718, tarAITarget } },
				--Reaper - Death Shadow: blinks behind the target and launches it upward
				{ batSyncCastSpellToTarget, param = { 5719, tarAITarget } },
