};

evtAIDie=
{ batParallel,
	{ batSetCharHp, param = { tarSelf, 1 } },
	{ batInvincible, param = { true } },    
	{ batSyncBreakCast, param = { true } },
	{ batOpenDoor, param={ 63 },
	},
	{ batPlayAction, param = { 254 } },

	{ batSetSceneVariable, param={ 15, 2 },
	},
	{ batWait, param={ 32000 },
	},
	{ batSetSceneVariable, param={ 15, 0 },
	},
	_cast_template_spell(nastDeadSpell, tarAITarget, 0),
	{ batInvincible, param = { false } },
};

