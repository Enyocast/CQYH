-- tree evtAIDie refer external: -- 
-- external table or function:  batGuildCheckWarStage
-- external table or function:  batGuildEndWar


on_fight_move =
{ batSequencer,
	{ batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
	{ building_say },
	{ batSetCDTimer, param = { COOLDOWN_AI, 10, 15000 } },
};

evtAIDie = 
{ batParallel,
	{ batSetFlag, param = { cfBTDenyDie } },
	{ batInvincible, param = { true } },
	{ batSequencer,
		{ batCheckGuildWarCharacter, param = { GUILD_WAR_INTRUDER } },
		{ batGuildEndWar, param = { GUILD_WAR_DEFENDER_LOSE } },
	}, 
	{ batGBuildingDead, },
	{ batSetCharHp, param = { tarSelf, 1, 0, 0 } },
	--{ batAddAura, param = { tarSelf, 2230 } },
	{ batPlayAction, param = { 1 } },
	{ batWait, param = { 2000 } },
	{ batInvincible, param = { false } },
	{ BuildingDead },
};
