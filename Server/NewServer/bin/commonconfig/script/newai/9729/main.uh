on_wander = 
{ batSelector, 
	{batSequencer,
		{ batMoveTo, param={ tarPosition,39000,55300,650}, },
		{ batSelector,
			{batSequencer,
				{ batCheckSceneVariable , param={ boGTE, 10, 50 } },
				{ batSetSceneVariable , param={ 11, 1 } },
				{ batSuicide, param = { 1, true },},
				
			},
			{batSequencer,
				{ batCheckDistanceCM, param = {boLTE,39000,55300,1500},},
				{ batSetSceneVariable , param={ 10, 0, 1 } },
				{ batSay, param = { cctScene, 666725, cltTvShow } },
				{ batSay, param = { cctScene, 666725, cltNormal } },
				{ batSuicide, param = { 1, true },},
				
			},
		},	
	},
};

on_chase = 
