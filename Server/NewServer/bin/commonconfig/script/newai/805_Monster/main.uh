local boss_stage_1 = 1;
local boss_stage_2 = 2;
local boss_stage_3 = 3;
local boss_stage_4 = 4;
local boss_stage_5 = 5;

local spell_common =
{
	{ id = 5665, cd = 0, chance = 10000, target = tarAITarget },            --Narwhal leader - Whale Feast: summons many narwhals to use "Savage Whale Charge" (like the Beastmaster ultimate in Warcraft III), leaving space between them for players to dodge. The boss is immune to control during the cast but still takes damage.
	{ id = 5662, cd = 30000, chance = 10000, target = tarAITarget },        --Narwhal leader - Seafood Spiral: spins 360 degrees with arms extended, attacking nearby enemies and dropping fish and shrimp that damage players on contact. Reflects ranged damage during the spin; afterward it bends to pick up a fish and has a long recovery.
	{ id = 5663, cd = 40000, chance = 10000, target = tarAITarget },        --Narwhal leader - Shark Charge: lowers its horn, paws twice like a bull and charges rapidly, then staggers as if it overshot.
	{ id = 5664, cd = 25000, chance = 10000, target = tarFarthestEnemy },   --Narwhal leader - Sky Comet Throw: charges and grabs, preferring distant targets, then spins upward and slams the target into the ground like Zangief in Street Fighter. It falls and slowly rises afterward; a miss leaves it vulnerable.
	{ id = 5660, cd = 0, chance = 7000 },                                   --Narwhal leader - Double Strike: consecutive left and right strikes
	{ id = 5661, cd = 0, chance = 7000 },                                   --Narwhal leader - Flatten for Cooking: a combination of palm strikes that leaves an opening
	{ id = 5666, cd = 25000, chance = 10000, target = tarAITarget },        --Narwhal leader - Bone Rattler: grabs a target by the ankle and slams it over its head to the left and right twice before putting it down, like Chang Koehan in KOF 97.
};

on_init =
{ batSequencer, 
	{ batSetBossState, param = { 1 } },
	{ batSetCDTimer, param = { COOLDOWN_AI , 100 , 10000},},
};

on_chase =
{ batSequencer,
	__check_dice(6000),
    __cast_spell(spell_common[2].id, spell_common[2].target, spell_common[2].chance, spell_common[2].cd); 
};

fight_sub = 
{ batParallel,
	__scan_nearby();

	{ batSequencer,
		__check_cd_timer(COOLDOWN_AI, SPELL_GROUP_CD_TIMER_INDEX);
		__set_cd_timer(COOLDOWN_AI, SPELL_GROUP_CD_TIMER_INDEX, 3000);
		{ batSelector,
			{ batSequencer,
				__check_dice(7000);
				__cast_spell(spell_common[5].id, tarAITarget, spell_common[5].chance, spell_common[5].cd);
			},
			__cast_spell(spell_common[6].id, tarAITarget, spell_common[6].chance, spell_common[6].cd);
		},
	},

	{ batSequencer,
	    { batRandom, param = { 4000, 6000 },
		    __cast_spell(spell_common[7].id, tarAITarget, spell_common[7].chance, spell_common[7].cd);
		    { batSequencer,
		        __cast_spell(spell_common[4].id, tarAITarget, spell_common[4].chance, spell_common[4].cd);
		        __change_target(10000, 15000, d.nChaseRange, 0);
			},
	    },
	},

	{ batSelector,
		{ batSequencer,
       		{ batCheckCharHp, param = { tarSelf, boLTE, 5000 } };
			__cast_spell(spell_common[2].id, spell_common[2].target, spell_common[2].chance, spell_common[2].cd);
		},	
		__cast_spell(spell_common[3].id, spell_common[3].target, spell_common[3].chance, spell_common[3].cd);
	},
};

stage_tree_1 =
{ batSequencer,
	{ batCheckBossState, param = { 1 } },
	fight_sub,
	{ batSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 8000 } };
		__cast_spell(spell_common[1].id, spell_common[1].target, spell_common[1].chance, spell_common[1].cd);
		{ batSetBossState, param = { 2 } },
	},
};

stage_tree_2 =
{ batSequencer,
	{ batCheckBossState, param = { 2 } },
	fight_sub,
	{ batSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 6000 } };
		__cast_spell(spell_common[1].id, spell_common[1].target, spell_common[1].chance, spell_common[1].cd);
		{ batSetBossState, param = { 3 } },
	},
};

stage_tree_3 =
{ batSequencer,
	{ batCheckBossState, param = { 3 } },
	fight_sub,
	{ batSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 4000 } };
		__cast_spell(spell_common[1].id, spell_common[1].target, spell_common[1].chance, spell_common[1].cd);
		{ batSetBossState, param = { 4 } },
	},
};

stage_tree_4 =
{ batSequencer,
	{ batCheckBossState, param = { 4 } },
	fight_sub,
	{ batSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 2000 } };
		__cast_spell(spell_common[1].id, spell_common[1].target, spell_common[1].chance, spell_common[1].cd);
		{ batSetBossState, param = { boss_stage_5 } },
	},
};

stage_tree_5 =
{ batSequencer,
	{ batCheckBossState, param = { 5 } },
	fight_sub,
};

on_cast_spell =
{ batSelector,
	stage_tree_1,
	stage_tree_2,
	stage_tree_3,
	stage_tree_4,
	stage_tree_5,
};

on_wander =
{ batSequencer, 
	{ batSetBossState, param = { 1 } },
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[2].id, spell_common[2].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[3].id, spell_common[3].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[4].id, spell_common[4].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[7].id, spell_common[7].cd);
	{ batCheckCDTimer , param = { COOLDOWN_AI , 100 },},
	{ batSetCharHp , param = { tarSelf , 0 },},	
};

evtAIDie = 
{batParallel ,
    { batSequencer,
        { batSay, param = { cctScreen, 50310, cltNormal },},
        --{ batSpawnSingleNpc, param={ 0 },},
    },
};
