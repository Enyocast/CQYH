
on_enter_fight = 
{ batSequencer, 
     { batSetCDTimer, param = { COOLDOWN_AI, 10, 15000 } },
};


on_cast_spell = 
{ batSequencer,
	{ batCheckCanCastSpell },
	__check_cd_timer(COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime),
	{ batSelector, 
		{ batSequencer,
			{ batCheckCharHp , param = { tarSelf, boLTE, 2000 } },	
		    { batCheckCDTimer, param = { COOLDOWN_AI, 12 } },
			{ batSyncCastSpellToTarget, param = { 3708, tarSelf } },		
			{ batSetCDTimer, param = { COOLDOWN_AI, 12, 600000 } },
			{ batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },		
	    { batSequencer,		
		   { batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
		   { batRandom , param = { 5000, 5000 }, 
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3706, tarSelf } },	
					{ batSetBossState , param = { 1 } },							
				},
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3707, tarSelf } },	
					{ batSetBossState , param = { 2 } },
				},
		   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 10, 15000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },			
		{ batSequencer,		
		    { batCheckBossState, param = { 1 } },		
			{ batCheckCDTimer, param = { COOLDOWN_AI, 11 } },
			   { batRandom , param = { 5000, 5000 },
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 3703, tarAITarget } },		
					},
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 3705, tarAITarget } },		
					},
			   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 11, 3000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, nGlobalCDTime } },
	    },			
		{ batSequencer,		
		    { batCheckBossState, param = { 2 } },		
			{ batCheckCDTimer, param = { COOLDOWN_AI, 11 } },
			   { batRandom , param = { 5000, 5000 },
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 3703, tarAITarget } },		
					},
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 3704, tarAITarget } },		
					},
			   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 11, 3000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, nGlobalCDTime } },
	    },		
    },
};