
on_enter_fight = 
{ batSequencer, 
     { batSetCDTimer, param = { COOLDOWN_AI, 10, 12000 } },
};


on_cast_spell = 
{ batSequencer,
	{ batCheckCanCastSpell },
	__check_cd_timer(COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime),
	{ batSelector, 		
	    { batSequencer,		
		   { batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
		   { batRandom , param = { 5000, 5000 }, 
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3652, tarAITarget } },								
				},
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3653, tarAITarget } },	
				},
		   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 10, 45000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },				
		{ batSequencer,		
		   { batCheckCharHp , param = { tarSelf, boLTE, 6000 } },	
		   { batCheckCDTimer, param = { COOLDOWN_AI, 11 } },
		   { batRandom , param = { 5000, 5000 }, 
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3658, tarSelf } },								
				},
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3659, tarSelf } },	
				},
		   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 11, 30000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },	
	},	
};