-- Temporary AI
--
bs_rockman_stage_1 = 0;
bs_rockman_stage_2 = 1;

RockManSpell =
{
	--{ spellid, chance, cdtime }
	--
	-- stage 1:
	--spell
	{ id = 5826, chance = 10000, cd = 18000},
	{ id = 5825, chance = 10000, cd = 8000 },
	{ id = 5825, chance = 10000, cd = 8000 },	
	{ id = 5832, chance = 10000, cd = 10000 },
	{ id = 5878, chance = 10000, cd = 1000 },

	-- stage 2:
	{ id = 5827, chance = 7000, cd = 5000 },
	{ id = 5828, chance = 5000, cd = 5000 },
	{ id = 5831, chance = 1000, cd = 5000 },

	{ id = 5829, chance = 5000, cd = 5000 },
	{ id = 5830, chance = 2000, cd = 5000 },
};


stage_tree_1 = 
{ btSequencer,
	{ batCheckBossState, param = { bs_rockman_stage_1 } },
	{ btParallel,
		__cast_spell(RockManSpell[1].id, tarAITarget, RockManSpell[1].chance, RockManSpell[1].cd);
		__cast_spell(RockManSpell[2].id, tarAITarget, RockManSpell[2].chance, RockManSpell[2].cd);
		__cast_spell(RockManSpell[3].id, tarAITarget, RockManSpell[3].chance, RockManSpell[3].cd);	
		__cast_spell(RockManSpell[5].id, tarAITarget, RockManSpell[5].chance, RockManSpell[5].cd);
	},
	{ btSequencer,
		{ batCheckCharHp, param = { tarSelf, boLTE, 5000, 0 } },
		__cast_spell(RockManSpell[4].id, tarAITarget, RockManSpell[4].chance, RockManSpell[4].cd);
		{ batSetBossState, param = { bs_rockman_stage_2 } },
	},
};

stage_tree_2 = 
{ btSequencer,
	{ batCheckBossState, param = { bs_rockman_stage_2 } };
	{ btSelector,
		__flee(d.nFleeHpPercent, d.nFleeChance, 20000, d.nFleeDuration, d.nRunSpeed * 1000 / GAME_FPS),
		__fight_move(d.nPreferDistance, d.nWithdrawThreshold, d.nChaseThreshold, d.nRunSpeed * 1000 / GAME_FPS, d.nStepAroundChance, d.nStepAroundCDTime),
		{ btSequencer,
			{ batCheckCharHp, param = { tarSelf, boLTE, 3000, 0 } },
			__cast_spell(RockManSpell[9].id, tarAITarget, RockManSpell[9].chance, RockManSpell[9].cd);
			__cast_spell(RockManSpell[10].id, tarAITarget, RockManSpell[10].chance, RockManSpell[10].cd);
		},
	
		__cast_spell(RockManSpell[6].id, tarAITarget, RockManSpell[6].chance, RockManSpell[6].cd);
		__cast_spell(RockManSpell[7].id, tarAITarget, RockManSpell[7].chance, RockManSpell[7].cd);
		__cast_spell(RockManSpell[8].id, tarAITarget, RockManSpell[8].chance, RockManSpell[8].cd);
		__chase(d.nRunSpeed * 1000 / GAME_FPS, d.nPreferDistance, d.nChaseThreshold, d.nChaseDelayTime),
	},
};

evtAIInit =
{ btParallel,
	_init_tree();
	{ batSetFlag, param = { cfImmuneStiff } },
	{ batSetFlag, param = { cfImmuneControl } },
	{ batSetFlag, param = { cfImmunePassiveMove } },
	{ batSetBossState, param = { bs_rockman_stage_1 } },
};

fight_sub = 
{ btSelector,
	stage_tree_1,
	stage_tree_2,
};

evtAIFight = 
{ batParallel,
	__issue_threat_signal(d.nSpreadThreatCount),
	__change_target(d.nChangeTargetChance, d.nChangeTargetCDTime, d.nChaseRange, d.nChangeTargetDelayTime),
	{ batSelector,
		__check_live_timer(d.nLiveTime),
		__check_out_of_range(d.nChaseRange),    
		__check_target_die(d.nChaseRange),
		fight_sub,
	},
};

evtAIIdle =
{ batSelector,
	__check_live_timer(d.nLiveTime),
	_detect_enemy(),
};

