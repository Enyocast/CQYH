function get_remain_time()
	local role = CGameWorld:GetInstance():FindValidRole(get_ctx_role_id());
	if not role then
		return 0;
	end

	local t = role:GetCoolDown():GetRemainFrm(MakeCoolDownID(COOLDOWN_MISC, COOLDOWN_MISC_ARREST)) / GAME_FPS / 60;
	print (t)
	if t <= 0 then
		return 0;
	else	
		return t + 1  ;
	end
end

