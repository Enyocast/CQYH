on_init = 
	{ batSequencer, 
	  { batSetAlwaysRun , param = { true } },
	  { batSetCDTimer, param = { COOLDOWN_AI, 10, d.nParam[0], d.nParam[1] } },   --Index 10 is for summons; param 0 is minimum time and param 1 maximum time, capped at half an hour; maximum lifetime is half an hour, d.nParam[0]
	};


on_wander = 
	{ batSequencer, 
	  { batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
			{ batRandom, param = { 3000 , 3000 , 3000 }, 
				{ batSequencer,
						{ batSpawnNpc  , param = { 5297, 45500, 31600, 8000 } },
						{ batSpawnNpc  , param = { 5298, 32500, 41500, 8000 } },
						{ batSpawnNpc  , param = { 5298, 21000, 33000, 8000 } },
						{ batSuicide, param = { false, false } },
				},	
				{ batSequencer,
						{ batSpawnNpc  , param = { 5298, 45500, 31600, 8000 } },
						{ batSpawnNpc  , param = { 5297, 32500, 41500, 8000 } },
						{ batSpawnNpc  , param = { 5298, 21000, 33000, 8000 } },
						{ batSuicide, param = { false, false } },
				},	
				{ batSequencer,
						{ batSpawnNpc  , param = { 5298, 45500, 31600, 8000 } },
						{ batSpawnNpc  , param = { 5298, 32500, 41500, 8000 } },
						{ batSpawnNpc  , param = { 5297, 21000, 33000, 8000 } },
						{ batSuicide, param = { false, false } },
				},			
			},	
		
	};
