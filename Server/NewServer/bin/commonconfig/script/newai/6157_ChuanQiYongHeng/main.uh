function _chuanqi_collection()

	local temp_table =
	{ batSelector,

		{ batSequencer,
			{ batRoleCheckDailyVariable, param = { 201 } },	
			{ batRoleOpenDialog, param = { 50123, 30000 } },
			{ batRoleCheckInteractOption, param = { 1 } },
			{ batSelector,

				{ batSequencer,
					{ batRoleCheckItemCount, param = { boLT,character_table[1], 1 } }, 
					{ batRoleOpenDialog, param = { 50125, 50000, 0, 0 } },
				}, 
				{ batSequencer,
					{ batRoleCheckItemCount, param = { boLT,character_table[2], 1 } }, 
					{ batRoleOpenDialog, param = { 50125, 50000, 0, 0 } },
				}, 
				{ batSequencer,
					{ batRoleCheckDailyVariable, param = { 201 } },	
					{ batRoleCheckItemCount, param = { boGTE,character_table[1], 1 } }, 
					{ batRoleCheckItemCount, param = { boGTE,character_table[2], 1 } },
					_exp_add_1(),
				}, 
				{ batSequencer,
					{ batRoleOpenDialog, param = { 50122, 50000, 0, 0 } },
				}, 
			},	
		},	
		
		--Already claimed
		{batSequencer,
			{ batRoleOpenDialog, param = { 50122, 50000, 0, 0 } },
		},		
	};

	return temp_table;
end


