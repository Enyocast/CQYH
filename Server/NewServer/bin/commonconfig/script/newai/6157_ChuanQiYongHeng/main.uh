function _exp_add_1()
	local temp_table = 
		{batSequencer,
			{ batRoleDelItem, param = { character_table[1], 1 } },
			{ batRoleDelItem, param = { character_table[2], 1 } },
			{ batRoleUpdateDailyVariable, param = { 201, 0 } },
			{ batRandom, param = {4000, 3000, 2000, 1000 },
				{ batAddExp, param={ tarRole , exp_table_1[1] } },	
				{ batAddExp, param={ tarRole , exp_table_1[2] } },
				{ batAddExp, param={ tarRole , exp_table_1[3] } },
				{ batAddExp, param={ tarRole , exp_table_1[4] } },
			},	
			{ batRoleOpenDialog, param = { 50126, 50000, 0, 0 } },
		};

	return temp_table;
end


function _exp_add_2()
