evtAIInteract = 
{ batSequencer,
	{ batRoleOpenDialog, param = { 666801, 50000, 'get_Total()', 'get_ABC()' } },	-- Ichiban prize: change get_power() to return the remaining prizes and, if possible, counts for each of the A, B and C grand prizes
	{ batSelector, 
		{ batSequencer, 
			{batRoleCheckInteractOption, param = { 1 } },--Buy one
			{batSelector,
				{batSequencer,--Purchase logic follows
					{ Buy_One },
				},
				{batSequencer,
					{ batRoleOpenDialog, param = { 666802, 50000, 0, 0 } },
				},
			},
		},
		{ batSequencer, 
			{batRoleCheckInteractOption, param = { 2 } },--Buy 10
			{batSelector,
				{batSequencer,--Purchase logic follows
					{ Buy_Ten },
				},
				{batSequencer,
					{ batRoleOpenDialog, param = { 666802, 50000, 0, 0 } },
				},
			},
		},
		{ batSequencer, 
			{batRoleCheckInteractOption, param = { 3 } },--Claim the W prize
			{batSelector,
				{batSequencer,--Purchase logic follows
					{ Get_Big },
				},
				{batSequencer,
					{ batRoleOpenDialog, param = { 666803, 50000, 0, 0 } },
				},
			},
		},
	},
};

evtAIIdle = 
{ batSelector,
	{ batSequencer,
		{ batWait, param = { 'get_wait_time()' } },	--Wait until the daily reset
