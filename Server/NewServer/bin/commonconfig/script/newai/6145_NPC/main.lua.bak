function Get_Big(owner)
	if #arr ~= 0 then
		return brvFail;
	end
	local role = g_oGameWorld:FindValidRole(get_ctx_role_id());
	if LuckBabbyRoleID ~= get_ctx_role_id() then
		return brvFail;
	end

	role:GetTitle():AddTitle(80);
	local msg = "恭喜"..role:GetName().."玩家获得一番赏的W奖超级称号！"
	role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的W奖超级称号！");
	role:Say(cctServer, cltLighting, msg);
	LuckBabbyRoleID = 0;
	return brvSuccess;
end

function get_wait_time(owner)
	print("get_wait_time start");
	if WaitTime ~= 0 then
		return WaitTime;
	end
	--print("get_wait_time 1");
	local t1 = os.time();
	t1 = t1 + 28800 ;
	while t1 > 86400 do
		t1 = t1 - 86400;
	end
	--print(t1);
	if t1 < 64800 then
		--print(64800 - t1);
		WaitTime = 64800 - t1;
	else
		--print(86400 + 64800 - t1);
		WaitTime = 86400 + 64800 - t1;
	
	end
	
	print("get_wait_time end");
	WaitTime = WaitTime * 1000;
	print(WaitTime);
	return WaitTime;
end

