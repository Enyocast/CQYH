function Buy_One(owner)
	if #arr == 0 then
		return brvFail;
	end
	local role = g_oGameWorld:FindValidRole(get_ctx_role_id());
	local itemBag = role:GetItemBag();
	if 1001 - #arr == LuckBabby then
		--print(LuckBabbyRoleID);
		LuckBabbyRoleID = get_ctx_role_id();
		LuckBabbyName = role:GetName();
		--print(LuckBabbyRoleID);
	end
	local n=math.random(1,#arr);
	--print(n);
	--print(arr[n]);
	local free_slot_count = itemBag:GetFreeSlots(CONSLOT_DEFAULT);
	if free_slot_count < 1 then
		return brvFail;
	end
	if itemBag:GetMoney(3) < 500 then
		return brvFail;
	end
	itemBag:ChangeYuanbao(role:GetUserName(),500,false,0,0);
	if arr[n] <= A then
		itemBag:AddItem(1800018, 1, ITEMLOG_SCRIPT, 0, false);
		local msg = "恭喜"..role:GetName().."玩家获得一番赏的A奖10%双倍经验丹！"
		role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的A奖10%双倍经验丹！");
		role:Say(cctServer, cltLighting, msg);
	elseif arr[n] <= B then
		itemBag:AddItem(1800019, 1, ITEMLOG_SCRIPT, 0, false);
		local msg = "恭喜"..role:GetName().."玩家获得一番赏的B奖500W双倍经验丹！"
		role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的B奖500W双倍经验丹！");
		role:Say(cctServer, cltLighting, msg);
	elseif arr[n] <= C then
		itemBag:AddMoney(1, 1000000, MONEYLOG_PACKAGE, 0,0);
		local msg = "恭喜"..role:GetName().."玩家获得一番赏的C奖100W金币！"
		role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的C奖100W金币！");
		role:Say(cctServer, cltLighting, msg);
	elseif arr[n] <= D then
		itemBag:AddItem(2800340, 1, ITEMLOG_SCRIPT, 0, false);
	elseif arr[n] <= E then
		itemBag:AddItem(1800040, 1, ITEMLOG_SCRIPT, 0, false);
	elseif arr[n] <= F then
		local cls = role:GetClass();
		if cls == clsWarrior then
			role:GetItemBag():AddItem(21001, 1, ITEMLOG_REAL_MONEY_SHOP, 0, true);
		elseif cls == clsMage then
			role:GetItemBag():AddItem(21002, 1, ITEMLOG_REAL_MONEY_SHOP, 0, true);
		elseif cls == clsTaoist then
			role:GetItemBag():AddItem(21003, 1, ITEMLOG_REAL_MONEY_SHOP, 0, true);
		end
	else
		itemBag:AddItem(2212, 1, ITEMLOG_SCRIPT, 0, false);
	end
	if #arr == 1 then
		itemBag:AddItem(2800143, 1, ITEMLOG_SCRIPT, 0, false);
	end
	if #arr == 1 then
		local msg = "恭喜"..LuckBabbyName.."玩家获得一番赏的最终大奖，请及时领取！"
		role:Say(cctServer, cltLighting, msg);
	end
	table.remove(arr,n);
	return brvSuccess;
end

function Buy_Ten(owner)
	if #arr == 0 then
		return brvFail;
	end
	local role = g_oGameWorld:FindValidRole(get_ctx_role_id());
	local itemBag = role:GetItemBag();
	local loop = 10;
	if #arr < 10 then
		role:GetScene():Say(role:GetObjID(), cltTvShow, "剩余次数不足10次，请单次购买！");
		return brvSuccess;
	end
	if itemBag:GetMoney(3) < 5000 then
		return brvFail;
	end

	local free_slot_count = itemBag:GetFreeSlots(CONSLOT_DEFAULT);
	if free_slot_count < 10 then
		role:GetScene():Say(role:GetObjID(), cltTvShow, "背包格子不够10格,请清理好背包后再购买！");
		return brvFail;
	end
	itemBag:ChangeYuanbao(role:GetUserName(),5000,false,0,0);

	while loop > 0 do
		if 1001 - #arr == LuckBabby then
			--print(LuckBabbyRoleID);
			LuckBabbyRoleID = get_ctx_role_id();
			LuckBabbyName = role:GetName();
			--print(LuckBabbyRoleID);
		end
		local n=math.random(1,#arr);

		if arr[n] <= A then
			itemBag:AddItem(1800018, 1, ITEMLOG_SCRIPT, 0, false);
			local msg = "恭喜"..role:GetName().."玩家获得一番赏的A奖10%双倍经验丹！"
			role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的A奖10%双倍经验丹！");
			role:Say(cctServer, cltLighting, msg);
		elseif arr[n] <= B then
			itemBag:AddItem(1800019, 1, ITEMLOG_SCRIPT, 0, false);
			local msg = "恭喜"..role:GetName().."玩家获得一番赏的B奖500W双倍经验丹！"
			role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的B奖500W双倍经验丹！");
			role:Say(cctServer, cltLighting, msg);
		elseif arr[n] <= C then
			itemBag:AddMoney(1, 1000000, MONEYLOG_PACKAGE, 0,0);
			local msg = "恭喜"..role:GetName().."玩家获得一番赏的C奖100W金币！"
			role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的C奖100W金币！");
			role:Say(cctServer, cltLighting, msg);
		elseif arr[n] <= D then
			itemBag:AddItem(2800340, 1, ITEMLOG_SCRIPT, 0, false);
		elseif arr[n] <= E then
			itemBag:AddItem(1800040, 1, ITEMLOG_SCRIPT, 0, false);
		elseif arr[n] <= F then
			local cls = role:GetClass();
			if cls == clsWarrior then
				role:GetItemBag():AddItem(21001, 1, ITEMLOG_REAL_MONEY_SHOP, 0, true);
			elseif cls == clsMage then
				role:GetItemBag():AddItem(21002, 1, ITEMLOG_REAL_MONEY_SHOP, 0, true);
			elseif cls == clsTaoist then
				role:GetItemBag():AddItem(21003, 1, ITEMLOG_REAL_MONEY_SHOP, 0, true);
			end
		else
			itemBag:AddItem(2212, 1, ITEMLOG_SCRIPT, 0, false);
		end
		if #arr == 1 then
			itemBag:AddItem(2800143, 1, ITEMLOG_SCRIPT, 0, false);
		end
		if #arr == 1 then
			local msg = "恭喜"..LuckBabbyName.."玩家获得一番赏的最终大奖，请及时领取！"
			role:Say(cctServer, cltLighting, msg);
		end
		table.remove(arr,n);
		loop = loop -1 ;
	end
	return brvSuccess;
end

function Buy_All(owner)
	if #arr == 0 then
		return brvFail;
	end
	local role = g_oGameWorld:FindValidRole(get_ctx_role_id());
	local itemBag = role:GetItemBag();
	local loop = #arr;
	local free_slot_count = itemBag:GetFreeSlots(CONSLOT_DEFAULT);
	if #arr > free_slot_count then
		role:GetScene():Say(role:GetObjID(), cltTvShow, "购买次数大于背包格子空余个数，请清理背包或单次购买！");
		return brvSuccess;
	end
	local yuanbao_cost = 200 * #arr;
	if itemBag:GetMoney(3) < yuanbao_cost then
		return brvFail;
	end
	
	itemBag:ChangeYuanbao(role:GetUserName(),yuanbao_cost,false,0,0);
	while loop > 0 do
		if 1001 - #arr == LuckBabby then
			--print(LuckBabbyRoleID);
			LuckBabbyRoleID = get_ctx_role_id();
			LuckBabbyName = role:GetName();
			--print(LuckBabbyRoleID);
		end
		local n=math.random(1,#arr);

		if arr[n] <= A then
			itemBag:AddItem(29920007, 1, ITEMLOG_SCRIPT, 0, false);
			local msg = "恭喜"..role:GetName().."玩家获得一番赏的A奖7星裁决！"
			role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的A奖7星裁决！");
			role:Say(cctServer, cltLighting, msg);
		elseif arr[n] <= B then
			itemBag:AddItem(29920006, 1, ITEMLOG_SCRIPT, 0, false);
			local msg = "恭喜"..role:GetName().."玩家获得一番赏的B奖6星裁决"
			role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的B奖6星裁决！");
			role:Say(cctServer, cltLighting, msg);
		elseif arr[n] <= C then
			itemBag:AddItem(29920005, 1, ITEMLOG_SCRIPT, 0, false);
			local msg = "恭喜"..role:GetName().."玩家获得一番赏的C奖5星裁决"
			role:GetScene():Say(role:GetObjID(), cltTvShow, "恭喜你获得一番赏的C奖5星裁决！");
			role:Say(cctServer, cltLighting, msg);
		elseif arr[n] <= D then
			itemBag:AddItem(2800299, 1, ITEMLOG_SCRIPT, 0, false);
		elseif arr[n] <= E then
			itemBag:AddItem(2800064, 1, ITEMLOG_SCRIPT, 0, false);
		elseif arr[n] <= F then
			itemBag:AddItem(80003, 1, ITEMLOG_SCRIPT, 0, false);
		else
			itemBag:AddItem(21001, 1, ITEMLOG_SCRIPT, 0, false);
		end
		if #arr == 1 then
			itemBag:AddItem(2800300, 1, ITEMLOG_SCRIPT, 0, false);
			itemBag:AddItem(2800300, 1, ITEMLOG_SCRIPT, 0, false);
		end
		if #arr == 1 then
			local msg = "恭喜"..LuckBabbyName.."玩家获得一番赏的最终大奖，请及时领取！"
			role:Say(cctServer, cltLighting, msg);
		end
		table.remove(arr,n);
		loop = loop -1 ;
	end
	return brvSuccess;
end

