function get_Total(owner)
	--print(LuckBabby);
	return #arr;
end
function get_ABC(owner)
	local loop = 1;
	local ABC = 0;
	local loop_max = 15;
	if #arr < loop_max then
		loop_max = #arr;
	end
	while loop < loop_max do
		if arr[loop] <= A then
			ABC = ABC + 100;
		elseif arr[loop] <= B then
			ABC = ABC + 10;
		elseif arr[loop] <= C then
			ABC = ABC + 1;
		end
		loop = loop + 1;
	end
	return ABC;
end
