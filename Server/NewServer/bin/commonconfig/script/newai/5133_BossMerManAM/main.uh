local boss_stage_1 = 1;
local boss_stage_2 = 2;
local boss_stage_3 = 3;

local spell_common =
{
	{ id = 5869, cd = 3500, chance = 10000, target = tarAITarget },   --1.鱼人法师首领-扇形冰刺 : 发出一个扇面的5根冰刺，发射有一定前摇
	{ id = 5870, cd = 15000, chance = 10000, target = tarSelf },      --2.鱼人法师首领-法术否定 : 释放一个法球给自己，可抵挡除了虚空尖射，魔雷箭，初生火灵，极冻碎裂波以外的一次魔法。每隔一段时间自己生成。
	{ id = 5871, cd = 20000, chance = 10000, target = tarAITarget },  --3.鱼人法师首领-能量失序 : 发出一道蓝色射线，反转一个目标的能量，并使其一段时间内无法回复。目标身上红蓝旋转
	{ id = 5872, cd = 60000, chance = 10000, target = tarAITarget },  --4.鱼人法师首领-睡眠之歌 : 扭动身体，并开始歌唱。歌唱会形成一个大范围的AOE，将停止除自己外所有目标的行动力。睡眠状态受攻击会造成3倍伤害然后苏醒过来，苏醒后能量为0。
	{ id = 5873, cd = 30000, chance = 10000, target = tarAITarget },  --5.鱼人法师首领-秘法之蛇 : 释放一个缓慢飞行但会连续撞击的法球，命中目标后会削弱目标50%攻击力和移动速度，同时提高自己25%攻击力，最多可打击5个不同目标。秘法之蛇释放后有概率立即释放海王之怒
	{ id = 5874, cd = 0, chance = 10000, target = tarAITarget },      --6.鱼人法师首领-呼风唤雨 : 双手高举，并吟唱。身后出现巨大人鱼化身，然后化作光升上天空，将区域的天气变为下雨。
	{ id = 5875, cd = 10000, chance = 10000, target = tarAITarget },  --7.鱼人法师首领-神力引爆 : 高抬手臂摇晃，间隔时间在空中暴开一个蓝色大范围光环，所有被人鱼弓手射中的角色都会被引爆一次。
	{ id = 5876, cd = 30000, chance = 10000, target = tarSelf },      --8.鱼人法师首领-海王之赐 : 召唤一个图腾在自己身体周围，进行缓慢地进行范围性群体回复
	{ id = 5877, cd = 30000, chance = 10000, target = tarAITarget },  --9.鱼人法师首领-海王之怒 : 秘法之蛇释放后，会连着释放。瞬移到平台中央，并开始进行施法。此时其本体不可移动，并出现一同施法的3个法师。击杀3个法师可阻止技能释放。如果阻止失败，以人鱼法师为中心，可以爆发一个强大的电环，造成重伤。
};

on_init =
{ batSequencer, 
	{ batSetFlag, param = { cfImmuneStiff } },
	{ batSetFlag, param = { cfImmuneControl } },
	{ batSetFlag, param = { cfImmunePassiveMove } },
	{ batSetBossState, param = { 1 } },
};

on_enter_fight =
{ batParallel,
	{ batPlayAction, param = { 253 } },
	{ batCloseDoor, param = { 63 } },
	{ batSetSceneVariable, param = { 14, 1 } },
};

on_wander = 
{ batSequencer,
	{ batCheckCDTimer, param = { COOLDOWN_AI, OPEN_DOOR_CD_TIMER } },
	{ batSetCDTimer, param = { COOLDOWN_AI, OPEN_DOOR_CD_TIMER, 3000 } },	
	{ batOpenDoor, param = { 63 } },
	{ batSetSceneVariable, param = { 14, 0 } },
	{ batSetBossState, param = { 1 } },
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[2].id, spell_common[2].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[3].id, spell_common[3].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[4].id, spell_common[4].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[5].id, spell_common[5].cd);	
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[7].id, spell_common[7].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[8].id, spell_common[8].cd);	
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[9].id, spell_common[9].cd);
};

fight_sub = 
{ batSelector,
	{ batSequencer,
	    { batCheckCharHp, param = { tarSelf, boLTE, 9000 } };
		__cast_spell(spell_common[3].id, spell_common[3].target, spell_common[3].chance, spell_common[3].cd);
	},	
	{ batSequencer,
	    { batCheckCharHp, param = { tarSelf, boLTE, 8000 } };
		__cast_spell(spell_common[8].id, spell_common[8].target, spell_common[8].chance, spell_common[8].cd);
	},	
	{ batSequencer,
	    { batCheckCharHp, param = { tarSelf, boLTE, 6000 } };
		__cast_spell(spell_common[4].id, tarAITarget, spell_common[4].chance, spell_common[4].cd);  
	},
	__cast_spell(spell_common[2].id, tarAITarget, spell_common[2].chance, spell_common[2].cd);
	__cast_spell(spell_common[7].id, tarAITarget, spell_common[7].chance, spell_common[7].cd);
	__cast_spell(spell_common[1].id, tarAITarget, spell_common[1].chance, spell_common[1].cd);
};

stage_tree_1 =
{ btSequencer,
	{ batCheckBossState, param = { 1 } },
	fight_sub,
	{ btSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 7000 } };
		__cast_spell(spell_common[6].id, spell_common[6].target, spell_common[6].chance, spell_common[6].cd);
		{ batSetBossState, param = { 2 } },
	},
};

stage_tree_2 =
{ btSequencer,
	{ batCheckBossState, param = { 2 } },
	fight_sub,
	{ btSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 4000 } };
		__cast_spell(spell_common[6].id, spell_common[6].target, spell_common[6].chance, spell_common[6].cd);
		{ batSetBossState, param = { 3 } },
	},
};

stage_tree_3 =
{ btSequencer,
	{ batCheckBossState, param = { 3 } },
	fight_sub,
	{ batSequencer,
		__cast_spell(spell_common[5].id, spell_common[5].target, spell_common[5].chance, spell_common[5].cd);
		{ batSequencer,
			__check_dice(6000);
		    __cast_spell(spell_common[9].id, spell_common[9].target, spell_common[9].chance, spell_common[9].cd);
		},
	},
};



on_cast_spell =
{ batSelector,
	stage_tree_1,
	stage_tree_2,
	stage_tree_3,
};

evtAIDie  = 
{ batSequencer,
	{ batOpenDoor, param={ 63 },
	},
	{ batPlayAction, param = { 254 } },
	{ batSetSceneVariable, param={ 14, 0 },
	},
};