local boss_stage_1 = 1;
local boss_stage_2 = 2;
local boss_stage_3 = 3;

local spell_common =
{
	{ id = 5869, cd = 3500, chance = 10000, target = tarAITarget },   --1. Merman mage leader - Ice Fan: fires five ice spikes in a fan after a wind-up
	{ id = 5870, cd = 15000, chance = 10000, target = tarSelf },      --2. Spell Negation: periodically creates an orb that blocks one spell except Void Spike, Magic Lightning Arrow, Newborn Fire Spirit and Freezing Shatter Wave
	{ id = 5871, cd = 20000, chance = 10000, target = tarAITarget },  --3. Energy Disorder: fires a blue ray that reverses one target’s energy and prevents recovery temporarily; red and blue effects rotate around the target
	{ id = 5872, cd = 60000, chance = 10000, target = tarAITarget },  --4. Sleep Song: sings a wide AOE that stops all other targets. An attack deals triple damage and wakes a sleeping target with zero energy.
	{ id = 5873, cd = 30000, chance = 10000, target = tarAITarget },  --5. Arcane Serpent: fires a slow orb that repeatedly hits up to five targets, reducing their attack and movement speed by 50% and increasing the caster’s attack by 25%; may immediately trigger Sea King’s Wrath
	{ id = 5874, cd = 0, chance = 10000, target = tarAITarget },      --6. Summon Rain: raises both hands and chants; a giant merman apparition rises as light and changes the area weather to rain
	{ id = 5875, cd = 10000, chance = 10000, target = tarAITarget },  --7. Divine Detonation: raises and waves its arms, periodically creating a wide blue aura that detonates each character struck by a merman archer
	{ id = 5876, cd = 30000, chance = 10000, target = tarSelf },      --8. Sea King’s Gift: summons a nearby totem that slowly heals a group in an area
	{ id = 5877, cd = 30000, chance = 10000, target = tarAITarget },  --9. Sea King’s Wrath: follows Arcane Serpent. The boss teleports to the platform center and casts while immobilized with three mages; killing them interrupts the cast, otherwise a powerful electric ring deals heavy damage.
};

on_init =
{ batSequencer, 
	{ batSetFlag, param = { cfImmuneStiff } },
	{ batSetFlag, param = { cfImmuneControl } },
	{ batSetFlag, param = { cfImmunePassiveMove } },
	{ batSetBossState, param = { 1 } },
};

on_enter_fight =
{ batParallel,
	{ batPlayAction, param = { 253 } },
	{ batCloseDoor, param = { 63 } },
	{ batSetSceneVariable, param = { 14, 1 } },
};

on_wander = 
{ batSequencer,
	{ batCheckCDTimer, param = { COOLDOWN_AI, OPEN_DOOR_CD_TIMER } },
	{ batSetCDTimer, param = { COOLDOWN_AI, OPEN_DOOR_CD_TIMER, 3000 } },	
	{ batOpenDoor, param = { 63 } },
	{ batSetSceneVariable, param = { 14, 0 } },
	{ batSetBossState, param = { 1 } },
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[2].id, spell_common[2].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[3].id, spell_common[3].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[4].id, spell_common[4].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[5].id, spell_common[5].cd);	
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[7].id, spell_common[7].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[8].id, spell_common[8].cd);	
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[9].id, spell_common[9].cd);
};

fight_sub = 
{ batSelector,
	{ batSequencer,
	    { batCheckCharHp, param = { tarSelf, boLTE, 9000 } };
		__cast_spell(spell_common[3].id, spell_common[3].target, spell_common[3].chance, spell_common[3].cd);
	},	
	{ batSequencer,
	    { batCheckCharHp, param = { tarSelf, boLTE, 8000 } };
		__cast_spell(spell_common[8].id, spell_common[8].target, spell_common[8].chance, spell_common[8].cd);
	},	
	{ batSequencer,
	    { batCheckCharHp, param = { tarSelf, boLTE, 6000 } };
		__cast_spell(spell_common[4].id, tarAITarget, spell_common[4].chance, spell_common[4].cd);  
	},
	__cast_spell(spell_common[2].id, tarAITarget, spell_common[2].chance, spell_common[2].cd);
	__cast_spell(spell_common[7].id, tarAITarget, spell_common[7].chance, spell_common[7].cd);
	__cast_spell(spell_common[1].id, tarAITarget, spell_common[1].chance, spell_common[1].cd);
};

stage_tree_1 =
{ btSequencer,
	{ batCheckBossState, param = { 1 } },
	fight_sub,
	{ btSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 7000 } };
		__cast_spell(spell_common[6].id, spell_common[6].target, spell_common[6].chance, spell_common[6].cd);
		{ batSetBossState, param = { 2 } },
	},
};

stage_tree_2 =
{ btSequencer,
	{ batCheckBossState, param = { 2 } },
	fight_sub,
	{ btSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 4000 } };
		__cast_spell(spell_common[6].id, spell_common[6].target, spell_common[6].chance, spell_common[6].cd);
		{ batSetBossState, param = { 3 } },
	},
};

stage_tree_3 =
{ btSequencer,
	{ batCheckBossState, param = { 3 } },
	fight_sub,
	{ batSequencer,
		__cast_spell(spell_common[5].id, spell_common[5].target, spell_common[5].chance, spell_common[5].cd);
		{ batSequencer,
			__check_dice(6000);
		    __cast_spell(spell_common[9].id, spell_common[9].target, spell_common[9].chance, spell_common[9].cd);
		},
	},
};



on_cast_spell =
{ batSelector,
	stage_tree_1,
	stage_tree_2,
	stage_tree_3,
};

evtAIDie  = 
{ batSequencer,
	{ batOpenDoor, param={ 63 },
	},
	{ batPlayAction, param = { 254 } },
	{ batSetSceneVariable, param={ 14, 0 },
	},
};