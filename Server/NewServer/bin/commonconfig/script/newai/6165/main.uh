evtAIInit = 
{ batParallel,
	{ batSetAlwaysRun, param = { true } },
};

evtAIInteract = 
{ batSequencer,
	{ batSelector,
		{ batSequencer,--Outside the reward claim period
			{ batCheckSceneVariable, param = { boNEQ, 1, 5 } },
			{ batRoleOpenDialog, param = { 666543, 30000 } },
		},
		{ batSequencer,--Reward claim period, but no guild occupies it
			{ batCheckSceneVariable, param = { boEQ, 1, 5 } },
			{ batCheckSceneVariable, param = { boEQ, 2, 0 } },
			{ batRoleOpenDialog, param = { 666544, 30000 } },
		},
		{ batSequencer,
			{ batCheckSceneVariable, param = { boEQ, 1, 5 } },
			{ batCheckSceneVariable, param = { boNEQ, 2, 0 } },
			{ batSelector,
				{ batSequencer,
					{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },--Enable two options for this guild
					{ batRoleOpenDialog, param = { 666545, 30000 } },
					{ batSelector,
						{ batSequencer,
							{ batRoleCheckInteractOption, param = { 1 } }, --Obtain a buff
							{ batRoleOpenDialog, param = { 666567, 30000 } },
							{ batRoleCheckInteractOption, param = { 1 } },
							{ batSelector,
								--Members of the occupying guild receive two buffs for free
								{ batSequencer,
									{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
									{ batRoleCheckDailyVariable, param = { 213 } },
									{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
									{ batRoleAddActivityPts , param = { 20 , aprGuildBoss} },
									{ batAddAura, param = { tarRole, 2521  } },
									{ batRoleUpdateDailyVariable, param = { 213, 0 } },
									{ batRoleOpenDialog, param = { 666546, 30000 } },
								},
								--Nonmembers pay for one buff
--[[								{ batSequencer,
									{ batRoleCheckDailyVariable, param = { 213 } },
									{ batNot,
										{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
									},
									{ batRoleOpenDialog, param = { 666547, 30000 } },
									{ batRoleCheckInteractOption, param = { 1 } }, --Confirm paying 150,000 for the buff
									{ batSelector,
										--Check the player’s money; reject players with less than 150,000
										{ batSequencer,
											{ batRoleCheckMoney, param = { boLT, 1, 150000 } }, --Confirm paying 150,000 for the buff
											{ batRoleOpenDialog, param = { 666548, 30000 } },
										},
										{ batSequencer,
											{ batRoleCheckMoney, param = { boGTE, 1, 150000 } }, --Confirm paying 150,000 for the buff
											{ batRoleSubMoney , param={ tarRole,1, 150000 } },
											{ batSetSceneVariable, param = { 3,0,150000 } },
											{ batAddAura, param = { tarRole, 2521  } },
											{ batRoleUpdateDailyVariable, param = { 213, 0 } },
											{ batRoleOpenDialog, param = { 666546, 30000 } },
										},
									},
								},--]]
								{ batSequencer,
									{ batRoleOpenDialog, param = { 666566, 30000 } },
								},
							},
						},
						{ batSequencer,
							{ batRoleCheckInteractOption, param = { 2 } }, --Elders and higher ranks can claim six titles
							{ batSelector,
								{ batSequencer,--Cannot claim if already holding six
									{ batCheckSceneVariable, param = { boGTE, 4, 6 } },
									{ batRoleOpenDialog, param = { 666549, 30000 } },
								},
								{ batSequencer,
									{ batRoleCheckTitle, param = { 99 } },	
									{ batRoleOpenDialog, param = { 666568, 30000 } },
								},
								{ batSequencer,
									{ batRoleCheckTitle, param = { 100 } },	
									{ batRoleOpenDialog, param = { 666568, 30000 } },
								},
								{ batSequencer,
									{ batRoleCheckTitle, param = { 101 } },	
									{ batRoleOpenDialog, param = { 666568, 30000 } },
								},
								{ batSequencer,
									{ batRoleCheckTitle, param = { 102 } },	
									{ batRoleOpenDialog, param = { 666568, 30000 } },
								},

								--Occupying guild
								{ batSequencer,
									{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },							
									{ batSelector,
										--Elders and higher ranks can claim six titles
										{ batSequencer,
											{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
											{ batRoleCheckPosition, param = { boGTE, 3 } },
											{ batSetSceneVariable, param = { 4,0,1 } },
											{ batRoleAddTitle, param = { 101 } }, 
											{ batRoleOpenDialog, param = { 666546, 30000 } },
										},
										--Reject insufficient rank
										{ batSequencer,
											{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
											{ batRoleCheckPosition, param = { boLT, 3 } },
											{ batRoleOpenDialog, param = { 666565, 30000 } },
										},							
									},
								},
								--Reject non-occupying guilds
								{ batSequencer,
									{ batRoleOpenDialog, param = { 666565, 30000 } },
								},
							},
						},
--[[						{ batSequencer,
							{ batRoleCheckInteractOption, param = { 3 } }, --Guild leader claims money
							{ batRoleOpenDialog, param = { 666551, 30000 } },
							{ batSelector,
								--Money claim option for the occupying guild leader
								{ batSequencer,
									{ batSelector,
										{ batSequencer,---Everyone can check the money
											{ batRoleCheckInteractOption, param = { 1 } },
											{ batRoleOpenDialog, param = { 666552,30000, 'o:GetScene():GetVariable(3)' } },
										},
										{ batSequencer,
											{ batRoleCheckInteractOption, param = { 2 } },
											{ batSelector,
												{ batSequencer,--Guild leader claims money
													{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
													{ batRoleCheckPosition, param = { boGTE, 2  } },
													{ batRoleAddMoney, param = { tarRole, 1, 'o:GetScene():GetVariable(3)' } },
													{ batSetSceneVariable, param = { 3,0 } },
													{ batRoleOpenDialog, param = { 666546, 30000 } },
												},
											--Reject non-occupying guilds
												{ batSequencer,
													{ batNot,
														{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
													},
													{ batRoleOpenDialog, param = { 666550, 30000 } },
												},
											--Reject insufficient rank
												{ batSequencer,
													{ batRoleCheckGuild, param = { 'o:GetScene():GetVariable(2)' } },
													{ batRoleCheckPosition, param = { boLT, 2 } },
													{ batRoleOpenDialog, param = { 666550, 30000 } },
												},
											},
										},
									},
								},
							},
						},--]]
					},
				},
				{ batSequencer,
					{ batRoleOpenDialog, param = { strAI6163_6_3, 30000 } },---Non-occupying guilds cannot claim these rewards
				},
			},
		},
	},
};

evtAIIdle = 
{ batSequencer,
	{ batSelector,
		--Start random monster spawns and announcements
		{ batSequencer,
			{ batSequencer,--Spawn a wave at 12:30
				{ batSelector,
					{ batCheckDateTime, param = { 0, 140000, 143000  } },
				},
				{ batCheckSceneVariable, param = {boEQ, 1, 0} },
				{ batSetSceneVariable, param = { 1, 0} },
				{ batSetSceneVariable, param = { 2, 0} },
				{ batSetSceneVariable, param = { 3, 0} },
				{ batSetSceneVariable, param = { 4, 0} },
				{ batRandom, param = {2500, 2500, 2500 },
					{ batSequencer,	
						{ batSetSceneVariable, param = { 1, 1} },
						{ batSay, param = { cctServer, 666559, cltLighting} },
						{ batSpawnDoodad, param = { 3104, 38054, 31058, 7179} },
					},
					{ batSequencer,	
						{ batSetSceneVariable, param = { 1, 2} },
						{ batSay, param = { cctServer, 666560, cltLighting} },
						{ batSpawnDoodad, param = { 3104, 22688, 57073, 7923} },
					},
					{ batSequencer,	
						{ batSetSceneVariable, param = { 1, 3} },
						{ batSay, param = { cctServer, 666561, cltLighting} },
						{ batSpawnDoodad, param = { 3104, 39991, 57432, 7238} },
					},
				},
			},
		},
		--End and enter the reward claim period
		{ batSequencer,
			{ batSequencer,--Reward claim period from 13:00 to 15:00
				{ batCheckDateTime, param = { 0, 143001, 163000  } },
				{ batCheckSceneVariable, param = {boGT, 1, 0} },
				{ batCheckSceneVariable, param = {boLT, 1, 5} },
				{ batSetSceneVariable, param = { 1, 5} },
				{ say_end_text },
			},
		},
		--Reward claim period ends
		{ batSequencer,
			{ batSequencer,--Reward claim period from 15:00 to 16:00
				{ batCheckDateTime, param = { 0, 163001, 170000  } },
				{ batCheckSceneVariable, param = {boNEQ, 1, 0} },
				{ batSetSceneVariable, param = { 1, 0} },
				{ batSetSceneVariable, param = { 2, 0} },
				{ batSetSceneVariable, param = { 3, 0} },
				{ batSetSceneVariable, param = { 4, 0} },
			},
		},
	},
};