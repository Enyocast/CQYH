on_init = 
{ batSequencer, 
    { batSetCDTimer, param = { COOLDOWN_AI, 100, 10000 } },
    { batSetCDTimer, param = { COOLDOWN_AI, 99, 180000 } },
	{ batSetCDTimer, param = { COOLDOWN_AI, 98, 5000 } },
};

on_enter_fight = 
{ batSequencer, 
    { batRemoveAura , param = { tarSelf , 35510 } },
};

on_cast_spell =
{ batSelector,
	{ batSequencer,
		{ batCheckCDTimer, param = { COOLDOWN_AI, 98 } },
		{ batSay, param = { cctScene, d.nParam[0] , cltTvShow} },
		{ batSetCDTimer, param = { COOLDOWN_AI, 98, 30000 } },
	},
	{ batSequencer,
		{ batCheckCDTimer, param = { COOLDOWN_AI, 100 } },
	   	 	{ batRandom , param = { 2500 , 2500 , 2500 , 2500 },
	       		{ batSequencer,
	       			{ batSay, param = { cctScene, 50069 , cltTvShow} },
	   	        	{ batSummonNpc, param= { 2139 },},
	        	},
	        	{ batSequencer,
	        		{ batSay, param = { cctScene, 50070 , cltTvShow} },
	   	        	{ batSummonNpc, param= { 2140 },},
	        	},
	        	{ batSequencer,
	        		{ batSay, param = { cctScene, 50071 , cltTvShow} },
	   	        	{ batSummonNpc, param= { 2141 },},
	        	},
	        	{ batSequencer,
	        		{ batSay, param = { cctScene, 50072 , cltTvShow} },
	            	{ batSummonNpc, param= { 2142 },},
	        	},
        	},
		{ batSetCDTimer, param = { COOLDOWN_AI, 100, 30000 } },	
	},
	{ batSequencer,
		{ batCheckCDTimer, param = { COOLDOWN_AI, 99 } },
		{ batSelector,
			{ batSequencer,
				{ batCheckAura, param = { tarAITarget , 2501 } },
				{ batSetCDTimer, param = { COOLDOWN_AI, 99, 5000 } }, 
			},
			{ batSequencer,
				{ batSay, param = { cctScene, 50073 , cltTvShow} },
				{ batAddAura, param = { tarAITarget , 2501 } }, 
				{ batSetCDTimer, param = { COOLDOWN_AI, 99, 5000 } },
			},	
		},
	},
};	
