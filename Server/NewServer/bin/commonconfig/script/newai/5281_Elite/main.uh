



on_cast_spell = 
{ batSequencer,
	{ batCheckCanCastSpell },
	__check_cd_timer(COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime),
	{ batSelector, 
		{ batSequencer,
			{ batCheckCharHp , param = { tarSelf, boLTE, 5000 } },	
		    { batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
			{ batSyncCastSpellToTarget, param = { 5819, tarSelf } },		
			{ batSetCDTimer, param = { COOLDOWN_AI, 10, 90000 } },
			{ batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },	
	    { batSequencer,		
			{ batCheckCDTimer, param = { COOLDOWN_AI, 11 } },
			   { batRandom , param = { 5000, 5000 }, 
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 5821, tarAITarget } },		
					},
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 5822, tarAITarget } },		
					},
			   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 11, 60000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },
		{ batSequencer,		
			{ batCheckCDTimer, param = { COOLDOWN_AI, 12 } },
			   { batRandom , param = { 5000, 5000 },
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 5823, tarAITarget } },		
					},
					{ batSequencer,
						{ batSyncCastSpellToTarget, param = { 5824, tarAITarget } },		
					},
			   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 12, 45000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, nGlobalCDTime } },
	    },			
    },
};