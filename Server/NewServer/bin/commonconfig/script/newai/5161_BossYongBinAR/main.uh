local scan_range = 1500;
local chase_range = 700;
local pref_dist = 700;
local pref_dist_offset = 200;
local run_speed = 600;
local chase_delay = 1000;

local spell_common =
{	-- 1. Spiral Impact Arrow: pushes units along its path and deals multiple hits
	{ id = 5583, cd = 5000, chance = 10000, group = 1 },
	-- 2. Trident: fires three arrows at units in a straight line
	{ id = 5879, cd = 2500, chance = 10000, group = 1 },
	-- 3. Emergency evade
	{ id = 5589, cd = 1000, chance = 10000 },
	-- 4. Chameleon
	{ id = 5584, cd = 1000, chance = 10000 },
	-- 5. Purgatory: knocks the target down and follows with multiple shots; only used in Chameleon state
	{ id = 5881, cd = 1000, chance = 10000 },
	-- 6. Emergency evade
	{ id = 5884, cd = 1000, chance = 10000 },
	-- 7. Hunt Mark: marks the target, increasing White Flash damage against it for 10 seconds
	{ id = 5586, cd = 12000, chance = 10000 },
	-- 8. Soul Link: share damage with White Flash for 20 seconds; cooldown 28 seconds
	{ id = 5587, cd = 15000, chance = 10000 },
};

evtAIInit =
{ batParallel, 
	_init_tree();
	__cast_init_spell(5880, 10000);
    { batSetScanFriendParam, param = { scan_range, 9257, 0, 0 } },
	{ batSetFlag, param = { cfImmuneStiff } },
	{ batSetFlag, param = { cfImmuneControl } },
	{ batSetFlag, param = { cfImmunePassiveMove } },
};

on_cast_spell = 
{ batSelector,
	{ btSequencer,
		__scan_nearby();
		{ batCheckDistance , param = { tarAITarget, boLTE, 400 } },		
		__check_cd_timer(COOLDOWN_AI, SPELL_GROUP_CD_TIMER_INDEX, 20000);
		__set_cd_timer(COOLDOWN_AI, SPELL_GROUP_CD_TIMER_INDEX, 20000);
		--5589
		__cast_spell(spell_common[3].id, tarAITarget, spell_common[3].chance, spell_common[3].cd);
		--5581 
		__cast_spell(spell_common[5].id, tarAITarget, spell_common[5].chance, spell_common[5].cd);
		--5584
		__cast_spell(spell_common[4].id, tarAITarget, spell_common[4].chance, spell_common[4].cd);
		
	},
 	{ batRandom, param = { 4000, 6000 }, 
 		{ btSequencer,
			--5583
			__cast_spell(spell_common[1].id, tarAITarget, spell_common[1].chance, spell_common[1].cd, 0, COOLDOWN_SCRIPT_SPELL, spell_common[1].group);
		},
		{ btSequencer,
			--5579
			__cast_spell(spell_common[2].id, tarAITarget, spell_common[2].chance, spell_common[2].cd, 0, COOLDOWN_SCRIPT_SPELL, spell_common[2].group);
		},
	},
	
 	
	--__cast_spell(spell_common[6].id, tarAITarget, spell_common[6].chance, spell_common[6].cd);

	{ btSequencer,
		__check_target(tarNearestFriend);
		{ batParallel,
			{ btSequencer,
				{ batCheckCDTimer, param={ COOLDOWN_AI , 10 },
   				},
					__cast_spell(spell_common[7].id, tarAITarget, spell_common[7].chance, spell_common[7].cd);
					{ batSay, param = { cctScreen, 50201, cltNormal } },
				{ batSetCDTimer , param={ COOLDOWN_AI , 10, 12000 },
        		},
			},
			{ btSequencer,
				{ batCheckCDTimer, param={ COOLDOWN_AI , 11},
   				},
				__cast_spell(spell_common[8].id, tarNearestFriend, spell_common[8].chance, spell_common[8].cd);
				{ batSay, param = { cctScreen, 50202, cltNormal } },
				{ batSetCDTimer, param={ COOLDOWN_AI , 11, 15000 },
        		},
			},
		},
	},
};
