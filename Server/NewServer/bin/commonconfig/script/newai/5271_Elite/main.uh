
on_enter_fight = 
{ batSequencer, 
     { batSetCDTimer, param = { COOLDOWN_AI, 10, 25000 } },
};


on_cast_spell = 
{ batSequencer,
	{ batCheckCanCastSpell },
	__check_cd_timer(COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime),
	{ batSelector, 		
	    { batSequencer,		
		   { batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
		   { batRandom , param = { 5000, 5000 }, 
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3645, tarAITarget } },								
				},
				{ batSequencer,
					{ batSyncCastSpellToTarget, param = { 3645, tarAITarget } },	
					{ batSyncCastSpellToTarget, param = { 3647, tarSelf } },
				},
		   }, 
		   { batSetCDTimer, param = { COOLDOWN_AI, 10, 45000 } },
		   { batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },		
    },
};