local boss_stage_1 = 1;
local boss_stage_2 = 2;
local boss_stage_3 = 3;

local spell_common =
{
	{ id = 5848, cd = 3000, chance = 10000 , target = tarAITarget},  
	--1. Bite the target repeatedly.
	{ id = 5849, cd = 20000, chance = 10000 , target = tarAITarget}, 
	--2. Charge forward, knocking units along the path down.
	{ id = 5850, cd = 12000, chance = 6000 , target = tarAITarget},  
	--3. Grab a target in front, shake it and throw it.
	{ id = 5851, cd = 30000, chance = 10000 , target = tarAITarget}, 
	--4. Slam the ground, creating a circular shockwave that detonates nearby stalagmites.
	{ id = 5852, cd = 20000, chance = 6000 , target = tarAITarget},  
	--5. Roar forward, fearing targets in range.
	{ id = 5853, cd = 30000, chance = 10000 , target = tarAITarget}, 
	--6. Roar and raise stalagmites around the boss, trapping up to eight targets.
	{ id = 5854, cd = 16000, chance = 6000 , target = tarAITarget}, 	
	--7. Stomp forward for area damage and continuously slow affected targets.
	{ id = 5855, cd = 0, chance = 10000 , target = tarAITarget},     
	--8. Fire lightning from the head crystal over a forward fan-shaped area.
	{ id = 5856, cd = 0, chance = 10000 , target = tarAITarget},     
	--9. Passive: when attacked, may break stone armor and counter with spikes that inflict bleeding.
	{ id = 5907, cd = 12000, chance = 6000 , target = tarAITarget},  
	--10. Burst the back stalagmites, then perform a 360-degree piercing attack like Maiev in Warcraft III.
	{ id = 5908, cd = 15000, chance = 6000 , target = tarAITarget},	 
	--11. Raise both legs and stomp to launch nearby enemies and create an impassable area.
};

fight_sub = 
{ batSelector,
	{ batSequencer,
	    { batCheckCharHp, param = { tarSelf, boLTE, 6000 } };
		__cast_spell(spell_common[5].id, tarAITarget, spell_common[5].chance, spell_common[5].cd);  
	},
	__cast_spell(spell_common[1].id, tarAITarget, spell_common[1].chance, spell_common[1].cd);
	__cast_spell(spell_common[3].id, tarAITarget, spell_common[3].chance, spell_common[3].cd);
};

stage_tree_1 =
{ batSequencer,
	{ batCheckBossState, param = { 1 } },
	fight_sub,
	{ batSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 8000 } };
		__cast_spell(spell_common[8].id, spell_common[8].target, spell_common[8].chance, spell_common[8].cd);
		{ batSetBossState, param = { 2 } },
	},
};

stage_tree_2 =
{ batSequencer,
	{ batCheckBossState, param = { 2 } },
	fight_sub,

	{ batSequencer,
		__cast_spell(spell_common[6].id, spell_common[6].target, spell_common[6].chance, spell_common[6].cd);
		__cast_spell(spell_common[4].id, spell_common[4].target, spell_common[4].chance, spell_common[4].cd);
	},

	{ batSequencer,
      	{ batCheckCharHp, param = { tarSelf, boLTE, 4000 } };
		__cast_spell(spell_common[8].id, spell_common[8].target, spell_common[8].chance, spell_common[8].cd);
		{ batSetBossState, param = { 3 } },
	},
};

stage_tree_3 =
{ batSequencer,
	{ batCheckBossState, param = { 3 } },
	fight_sub,
	{ batParallel,
		__cast_spell(spell_common[7].id, spell_common[7].target, spell_common[7].chance, spell_common[7].cd);
		__cast_spell(spell_common[10].id, spell_common[10].target, spell_common[10].chance, spell_common[10].cd);
		__cast_spell(spell_common[11].id, spell_common[11].target, spell_common[11].chance, spell_common[11].cd);
	},
};

on_chase =
{ batSequencer,
	__check_dice(6000),
    __cast_spell(spell_common[2].id, spell_common[2].target, spell_common[2].chance, spell_common[2].cd); 
};

on_cast_spell =
{ batSelector,
	stage_tree_1,
	stage_tree_2,
	stage_tree_3,
};

on_init =
{ batSequencer, 
	{ batSetBossState, param = { 1 } },
};

on_wander =
{ batSequencer, 
	{ batSetBossState, param = { 1 } },
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[2].id, spell_common[2].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[3].id, spell_common[3].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[4].id, spell_common[4].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[5].id, spell_common[5].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[6].id, spell_common[6].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[7].id, spell_common[7].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[10].id, spell_common[10].cd);
	__set_cd_timer(COOLDOWN_SCRIPT_SPELL, spell_common[11].id, spell_common[11].cd);	
};