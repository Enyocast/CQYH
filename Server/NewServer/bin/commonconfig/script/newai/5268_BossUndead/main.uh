on_wander = 
{ batParallel,
	{ batSequencer,
		{ batCheckAura , param = { tarSelf, 59091 } },
		{ batRemoveAura , param = { tarSelf, 59091 } },	 
	},	
};

on_enter_fight =
{ batSequencer, 
  { batSetCDTimer, param = { COOLDOWN_AI, 10, 1000 } },
  { batSetCDTimer, param = { COOLDOWN_AI, 11, 1000 } },
};


on_cast_spell = 
{ batSequencer,
	{ batCheckCanCastSpell },
	__check_cd_timer(COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime),
	{ batSelector, 
		{ batSequencer,
			{ batCheckCharHp , param = { tarSelf, boLTE, 5000 } },	
		    { batCheckCDTimer, param = { COOLDOWN_AI, 10 } },
			{ batSyncCastSpellToTarget, param = { 5909, tarSelf } },		
			{ batSetCDTimer, param = { COOLDOWN_AI, 10, 900000 } },
			{ batSetCDTimer, param = { COOLDOWN_AI, nastGlobalCDTimer, d.nGlobalCDTime } },
	    },	
    },
};
		

