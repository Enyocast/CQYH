    INT32   GetProsperity();
    void    SetProsperity(INT32 nProsperity);
    INT32   GetHerb();
    void    SetHerb(INT32 nHerb);
    INT32   GetWood();
    void    SetWood(INT32 nWood);
    INT32   GetCrystal();
    void    SetCrystal(INT32 nCrystal);
    INT32   GetSilver();
