$pfile "script/common.pkg"
$#include "scene.h"
$#include "math_ex.h"
$#include "scene_file_mgr.h"
$hfile "../../../Common/define/scene_def.h"
$hfile "../../inc/gameworld/scene_file_mgr.h"

class CScene
{
public:
	BOOL AddRole(CRole* opRole, INT32 nAppearType);
	BOOL RemoveRole(CRole* poRole);

	BOOL AddNpc(CNpc* poNpc, INT32 nAppearType);
	BOOL RemoveNpc(CNpc* poNpc);

	BOOL AddDoodad(CDoodad* poDoodad);
	BOOL RemoveDoodad(CDoodad* poDoodad);

    CNpc* SpawnNpc(INT32 nTemplateID, INT64 llX, INT64 llY, INT64 llZ, INT32 nFaceDirection, INT32 nSpawnerCharID, const NPC_SPAWN_POINT* pcSpawnPoint);
    CNpc* SpawnSingleNpc(INT32 nSingleNpcID);
    BOOL SpawnNpcMediumGroup(INT32 nMediumGroupID);
   	CNpc *FindNpc(INT32 nSingleNpcID);

    CDoodad* SpawnDoodad(INT32 nTemplateID, INT64 llX, INT64 llY, INT64 llZ, INT32 nFaceDirection);
    
    INT32 GetSceneTempID(void);
    inline INT32 GetSceneID(void);

	inline const SCENE_DATA* GetSceneData(void);
    inline CSceneStaticData* GetStaticData(void);

    INT32 GetLowerZ(INT32 nX, INT32 nY, INT32 nZ);
    void SetDoorState(INT32 nDoorID, BOOL bClosed);
    BOOL IsDoorClosed(INT32 nDoorID);
    
    void SetVariable(INT32 nIndex, INT32 nValue);
    INT32 GetVariable(INT32 nIndex);
    
    inline INT32 GetServerGroup(void);
    INT32 GetRoleCount(void);
    INT32 GetNpcCount(void);

	inline INT32 GetWeather(void);
	BOOL SetWeather(INT32 nWeather, INT32 nDurationFrame);

	inline BOOL IsSabacStarted(void);
	BOOL Say(UINT32 dwTargetID, UINT32 dwLocation, const char* pcszMessage);
};

class CSceneStaticData
{
public:
    const SCENE_TELEPORTS* FindTeleportPoint(INT32 nPointID);
    INT32 GetSingleNpcCount(void);

	const NPC_SPAWN_POINT* GetSingleNpc(const char* pcszName);
	const NPC_SPAWN_POINT* GetSingleNpcByName(NAMEID qwNameID);

    inline INT32 GetMaxZoneX(void);
    inline INT32 GetMaxZoneY(void);
	const GRID_DATA* GetGroundGrid(INT64 llX, INT64 llY);
};

class CSceneFileMgr
{
public:
    static CSceneFileMgr& GetInstance(void);

    CSceneStaticData* GetStaticData(UINT32 dwSceneTempID);
}

#define SIN_COS_NUMBER	(16384)

INT32 g_Sin(INT32 nDirection);
INT32 g_Cos(INT32 nDirection);
INT32 NormalizeDirection(INT32 nDirection);
INT64 g_GetDistance2D(INT64 llSrcX, INT64 llSrcY, INT64 llDestX, INT64 llDestY);
INT64 g_GetDistance3D(INT64 llSrcX, INT64 llSrcY, INT64 llSrcZ, INT64 llDestX, INT64 llDestY, INT64 llDestZ);
