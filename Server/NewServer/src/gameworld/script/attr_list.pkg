$pfile "script/common.pkg"
$#include "attr_list.h"

class CAttrList
{
public:
	INT32 GetAttr(INT32 eAttrType);
	
	void SetAttrBase(CCharacter* pSelf, INT32 eAttrType, INT32 nValue);

	void SetAttrA(CCharacter* pSelf, INT32 eAttrType, INT32 nValue);

	void SetAttrB(CCharacter* pSelf, INT32 eAttrType, INT32 nValue);

	inline void EnableAttr(INT32 eAttrType, BOOL bEnable);

	inline void AddAttrA(CCharacter* pSelf, INT32 eAttrType, INT32 nValue);
	inline void AddAttrB(CCharacter* pSelf, INT32 eAttrType, INT32 nValue);

	void CalculateAll(CCharacter* pSelf);
	void ReCalculateAttr(CCharacter* pSelf, INT32 eAttrType);
};