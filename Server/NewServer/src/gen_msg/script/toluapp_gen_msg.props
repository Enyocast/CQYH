<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup
    Condition="'$(toluapp_gen_msgBeforeTargets)' == '' and '$(toluapp_gen_msgAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <toluapp_gen_msgBeforeTargets>Midl</toluapp_gen_msgBeforeTargets>
    <toluapp_gen_msgAfterTargets>CustomBuild</toluapp_gen_msgAfterTargets>
  </PropertyGroup>
  <PropertyGroup>
    <toluapp_gen_msgDependsOn
      Condition="'$(ConfigurationType)' != 'Makefile'">_SelectedFiles;$(toluapp_gen_msgDependsOn)</toluapp_gen_msgDependsOn>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <toluapp_gen_msg>
      <CommandLineTemplate>script\toluappc.exe -L "$(ToluaFixedDateScript)" -D -c -a -e -n %(Filename) -o %(RootDir)%(Directory)tolua_%(Filename).cpp -H %(RootDir)%(Directory)tolua_%(Filename).h %(RootDir)%(Directory)%(Filename).epkg</CommandLineTemplate>
      <Outputs>%(RootDir)%(Directory)tolua_%(Filename).cpp</Outputs>
      <ExecutionDescription>Compiling tolua++ file %(Filename).epkg</ExecutionDescription>
      <ShowOnlyRuleProperties>false</ShowOnlyRuleProperties>
    </toluapp_gen_msg>
  </ItemDefinitionGroup>
</Project>