<Project>
  <!-- The separate legacy tool projects share the vendored sol2 headers. -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)NewServer\3rd\sol2\include;$(MSBuildThisFileDirectory)NewServer\inc\baselib;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
