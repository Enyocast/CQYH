<Project>
  <!-- Imported automatically by MSBuild (after the project) for every project under Server\. -->

  <!--
    Source and execution character sets.

    Sources are UTF-8. Keep the legacy GBK execution character set so narrow string literals
    continue to use the same bytes regardless of the Windows system language.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <ClCompile>
      <AdditionalOptions>%(AdditionalOptions) /source-charset:utf-8 /execution-charset:gbk /bigobj</AdditionalOptions>
      <LanguageStandard Condition="'$(LanguageStandard)' == ''">stdcpp17</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
