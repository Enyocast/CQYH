<Window x:Class="FileUpdate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内网版本更新" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Height="600" Width="800" WindowStartupLocation="CenterScreen" AllowsTransparency="False" WindowStyle="SingleBorderWindow" Opacity="1" ResizeMode="CanMinimize" WindowState="Normal" Loaded="Window_Loaded" Closed="Window_Closed" Icon="/FileUpdate;component/Images/fileupate.png">
    <StackPanel Height="558" Name="stackPanel1" Width="777" Orientation="Horizontal">
        <Canvas Height="554" Name="canvas1" Width="778">
            <GroupBox Header="QA版本" Height="118" Name="groupBox1" Width="313" Canvas.Left="464" Canvas.Top="0">
                <Grid>
                    <Button Content="更新Game" Height="40" HorizontalAlignment="Left" Margin="20,20,0,0" Name="button1" VerticalAlignment="Top" Width="113" Click="button1_Click" />
                    <Button Content="更新Editor" Height="39" HorizontalAlignment="Left" Margin="168,20,0,0" Name="button2" VerticalAlignment="Top" Width="113" Click="button2_Click" />
                    <Label Height="28" HorizontalAlignment="Left" Margin="20,67,0,0" Name="QAGameLabel" VerticalAlignment="Top" Width="113" ToolTip="本地版本号/服务器版本号" />
                    <Label Height="28" HorizontalAlignment="Left" Margin="168,67,0,0" Name="QAEditorLabel" VerticalAlignment="Top" Width="113" ToolTip="本地版本号/服务器版本号" />
                </Grid>
            </GroupBox>
            <GroupBox Header="开发版本" Height="118" Name="groupBox2" Width="313" Canvas.Left="464" Canvas.Top="124">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132*" />
                        <ColumnDefinition Width="169*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="更新Game" Height="40" HorizontalAlignment="Left" Margin="20,19,0,0" Name="button3" VerticalAlignment="Top" Width="113" Grid.ColumnSpan="2" Click="button3_Click" />
                    <Button Content="更新Editor" Height="39" HorizontalAlignment="Left" Margin="36,20,0,0" Name="button4" VerticalAlignment="Top" Width="113" Grid.Column="1" Click="button4_Click" />
                    <Label Height="28" HorizontalAlignment="Left" Margin="20,67,0,0" Name="DevGameLabel" VerticalAlignment="Top" Width="113" Grid.ColumnSpan="2" ToolTip="本地版本号/服务器版本号" />
                    <Label Height="28" HorizontalAlignment="Left" Margin="36,67,0,0" Name="DevEditorLabel" VerticalAlignment="Top" Width="113" Grid.Column="1" ToolTip="本地版本号/服务器版本号" />
                    <CheckBox Content="强制更新" Height="16" HorizontalAlignment="Left" Margin="20,0,0,0" Name="CheckBoxForceUpdate" VerticalAlignment="Top" IsChecked="True" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.ColumnSpan="2" Header="运行" Height="118" Margin="10,10,-22,-33" Name="groupBox3" Width="313" Canvas.Left="454" Canvas.Top="245">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132*" />
                        <ColumnDefinition Width="169*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="运行Game" Height="40" HorizontalAlignment="Left" Margin="19,22,0,0" Name="button5" VerticalAlignment="Top" Width="113" Click="button5_Click" />
                    <Button Content="运行Editor" Grid.Column="1" Height="39" HorizontalAlignment="Left" Margin="36,22,0,0" Name="button6" VerticalAlignment="Top" Width="113" Click="button6_Click" />
                    <CheckBox Content="英文版本" Height="16" HorizontalAlignment="Left" Margin="20,0,0,0" Name="CheckBoxEnglishVersion" VerticalAlignment="Top" />
                    <Label Height="28" HorizontalAlignment="Left" Margin="20,67,0,0" Name="GameVerLabel" VerticalAlignment="Top" Width="112" ToolTip="本地版本号" />
                    <Label Grid.Column="1" Height="28" HorizontalAlignment="Left" Margin="36,67,0,0" Name="EditorVerLabel" VerticalAlignment="Top" Width="113" ToolTip="本地版本号" />
                    <CheckBox Content="64位" Height="16" HorizontalAlignment="Left" Margin="107,0,0,0" Name="CheckBox64Bit" VerticalAlignment="Top" Grid.Column="1" IsChecked="True" />
                    <CheckBox Content="HD" Height="16" HorizontalAlignment="Left" IsChecked="True" Margin="91,0,0,0" Name="CheckBoxHD" VerticalAlignment="Top" Grid.ColumnSpan="2" />
                </Grid>
            </GroupBox>
            <GroupBox Header="发行版本" Height="118" Name="groupBox4" Width="313" Canvas.Left="464" Canvas.Top="380">
                <Grid>
                    <Button Content="更新Game" Height="40" HorizontalAlignment="Left" Margin="20,20,0,0" Name="button7" VerticalAlignment="Top" Width="113" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="button7_Click" />
                    <Button Content="启动Game" Height="39" HorizontalAlignment="Left" Margin="168,20,0,0" Name="button8" VerticalAlignment="Top" Width="113" Click="button8_Click" />
                    <Label Height="28" HorizontalAlignment="Left" Margin="20,67,0,0" Name="FinalGameUpdateLabel" VerticalAlignment="Top" Width="113" ToolTip="本地版本号/服务器版本号" />
                    <Label Height="28" HorizontalAlignment="Left" Margin="168,67,0,0" Name="labelFinalGame" VerticalAlignment="Top" Width="113" />
                </Grid>
            </GroupBox>
            <Button Canvas.Left="638" Canvas.Top="504" Content="更新版本信息" Height="39" Name="button9" Width="113" Click="button9_Click" />
            <Label Canvas.Left="0" Canvas.Top="0" Content="Update....0/0" Height="40" Name="MainText" Width="423" FontSize="24" FontWeight="Bold" />
            <ProgressBar Canvas.Left="0" Canvas.Top="49" Height="28" Name="MainProgressBar" Width="423" Value="100" Background="{x:Null}"></ProgressBar>
            <Grid Canvas.Left="89" Canvas.Top="397" />
            <TabControl Canvas.Left="0" Canvas.Top="85" Height="413" Name="tabControl1" Width="423" TabStripPlacement="Bottom">
                <TabItem Header="下载数据" Name="tabItemDownload" Foreground="Black">
                    <Grid>
                        <ScrollViewer Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="scrollViewer1" VerticalAlignment="Stretch" Width="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Height="Auto" Name="DownloadText" Text="NoTask" AllowDrop="False" ClipToBounds="False" Focusable="False" IsHyphenationEnabled="True" IsManipulationEnabled="True"><TextBlock.TextEffects><TextEffect><TextEffect.Foreground><LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5"><GradientStop Color="Black" Offset="0" /><GradientStop Color="White" Offset="1" /></LinearGradientBrush></TextEffect.Foreground></TextEffect></TextBlock.TextEffects></TextBlock>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="计算MD5" Name="tabItemMD5">
                    <ScrollViewer Height="Auto" Name="scrollViewer2" Width="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Height="Auto" Name="ComputeMD5Text" Text="NoTask" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="解压数据" Name="tabItemUncompress">
                    <ScrollViewer Height="Auto" Name="scrollViewer3" Width="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Height="Auto" Name="UncompressText" Text="NoTask" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="读磁盘" Name="tabItemRead">
                    <ScrollViewer Height="Auto" Name="scrollViewer4" Width="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Height="Auto" Name="ReadDiskText" Text="NoTask" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="写磁盘" Name="tabItemWrite">
                    <ScrollViewer Height="Auto" Name="scrollViewer5" Width="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Height="Auto" Name="WriteDiskText" Text="NoTask" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Label Canvas.Left="0" Canvas.Top="532" Height="24" Name="TimeText2" Width="423" />
            <Label Canvas.Left="0" Canvas.Top="502" Height="24" Name="TimeText1" Width="423" />
            <Button Content="更新材质缓存" Height="39" HorizontalContentAlignment="Center" Name="button10" VerticalContentAlignment="Center" Width="113" Canvas.Left="489" Canvas.Top="504" Click="button10_Click" />
        </Canvas>
        <Grid Width="366" />
    </StackPanel>
</Window>
