float4 ShadowCoordinateScaleBias;

float4x4 InvView;
float4x4 View;

float MaxInstances = 100000.0;

sampler VTFInstancePositionDataSampler;
sampler VTFInstanceScaleAndRotationDataSampler;
sampler VTFInstanceColorDataSampler;

#define MAX_SUBUV 128

float4  SubUVTable[MAX_SUBUV];
float	ScaleXSubUV = 0.5;
float	ScaleYSubUV = 0.5;
float	BlendSubUV   = 0;

// from Host vertex attributes.  #ifdef'd to control instancing vs VTF
struct FVertexFactoryInput
{
	// all we get is position and two packed tex coords when doing VTF, the rest comes from texture samples
	float4	Position	: POSITION;
	float4  TexCoord	: TEXCOORD0;

#if NEEDS_VERTEX_LIGHTMAP
	float4 LightMapA : TEXCOORD5;
	float4 LightMapB : TEXCOORD6;
	float4 LightMapC : TEXCOORD7;
#elif NEEDS_SIMPLE_VERTEX_LIGHTMAP
	float4 LightMapA : TEXCOORD5;
#endif

#if NEEDS_LIGHTMAP_COORDINATE
	float2	LightMapCoordinate : COLOR;
#endif
};

// Local remap input structure.  Depending on hardware instancing vs VTF  how we load these valus is different.
struct FInstancedVertexFactoryInput
{
	float4	Position	: POSITION;
	half3	TangentX	: TANGENT;
	// TangentZ.w contains sign of tangent basis determinant
	half4	TangentZ	: NORMAL;

#if NUM_MATERIAL_TEXCOORDS

#if SUBUV_PARTICLES
	float4	TexCoord	: TEXCOORD0;
	float4	Interp_Sizer : TEXCOORD1;
#else
	float2	TexCoord	: TEXCOORD0;
#endif

#endif

	float3	InstancePosition : TEXCOORD5;
	float4	InstanceVertexColor	 : TEXCOORD6;

#if NEEDS_VERTEX_LIGHTMAP
	float4 LightMapA : TEXCOORD5;
	float4 LightMapB : TEXCOORD6;
	float4 LightMapC : TEXCOORD7;
#elif NEEDS_SIMPLE_VERTEX_LIGHTMAP
	float4 LightMapA : TEXCOORD5;
#endif

#if NEEDS_LIGHTMAP_COORDINATE
	float2	LightMapCoordinate : COLOR;
#endif
};

struct FVertexFactoryInterpolantsVSToPS
{
#if WORLD_COORDS
	// First row of the tangent to world matrix
	float4	TangentToWorld0	: TANGENTTOWORLD0;
	// Last row of the tangent to world matrix in xyz
	float4	TangentToWorld2	: TANGENTTOWORLD2;
#endif
#if NEEDS_LIGHTMAP_COORDINATE
	float2	LightMapCoordinate	: TEXCOORD0;
#if NUM_MATERIAL_TEXCOORDS
	float2	TexCoord	: TEXCOORD1;
#endif
#else
#if NUM_MATERIAL_TEXCOORDS

#if SUBUV_PARTICLES
	float4	TexCoord	: TEXCOORD0;
#if !WORLD_COORDS
	float4	Interp_Sizer : TANGENTTOWORLD0;
#endif
#else
	float2	TexCoord	: TEXCOORD0;
#endif

#endif
#endif

#if !COMPILER_SUPPORTS_EMPTY_STRUCTS && !WORLD_COORDS && !NEEDS_LIGHTMAP_COORDINATE && !NUM_MATERIAL_TEXCOORDS
	float4 Dummy : TEXCOORD0;
#endif
	float4	InterpolantVertexColor	: TEXCOORD8;

};

struct FVertexFactoryIntermediates
{
	float Dummy;
};

FMaterialPixelParameters GetMaterialPixelParameters(FVertexFactoryInterpolantsVSToPS Interpolants)
{
	FMaterialPixelParameters	Result;

#if NUM_MATERIAL_TEXCOORDS

#if SUBUV_PARTICLES
	#if NUM_MATERIAL_TEXCOORDS >= 1
		Result.TexCoords[0] = Interpolants.TexCoord.xy;
	#if NUM_MATERIAL_TEXCOORDS >= 2
		Result.TexCoords[1] = Interpolants.TexCoord.zw;
	#if NUM_MATERIAL_TEXCOORDS >= 3
		// If WORLD_COORDS is true, Interp_Sizer was packed into the w, otherwise it gets its own interpolator.


	#if WORLD_COORDS
	Result.TexCoords[2] = Interpolants.TangentToWorld0.ww;
	#else
	Result.TexCoords[2] = Interpolants.Interp_Sizer.xx;
	#endif

	#endif	// >= 3
	#endif	// >= 2
	#endif	// >= 1

	#if NUM_MATERIAL_TEXCOORDS > 3
		for(int CoordinateIndex = 3;CoordinateIndex < NUM_MATERIAL_TEXCOORDS;CoordinateIndex++)
			Result.TexCoords[CoordinateIndex] = Interpolants.TexCoord.xy;
	#endif	// > 3
#else	//SUBUV_PARTICLES
	for(int CoordinateIndex = 0;CoordinateIndex < NUM_MATERIAL_TEXCOORDS;CoordinateIndex++)
		Result.TexCoords[CoordinateIndex] = Interpolants.TexCoord.xy;
#endif	//SUBUV_PARTICLES
#endif	//NUM_MATERIAL_TEXCOORDS

	Result.VertexColor = Interpolants.InterpolantVertexColor;
	Result.TangentNormal = 0;
	Result.TangentCameraVector = 0;
	Result.TangentReflectionVector = 0;
	Result.TangentLightVector = 0;
	Result.ScreenPosition = 0;

#if WORLD_COORDS
	Result.TangentToWorld = CalcTangentToWorld(float3(Interpolants.TangentToWorld0.xyz),Interpolants.TangentToWorld2);
	Result.UnMirrored = 1;
#endif

#if MATERIAL_DECAL
	Result.DecalAttenuation = 1;
	Result.DecalPlaneDistance = 0;
#endif

#if USE_DYNAMIC_PARAMETERS
	Result.DynamicParameter0 = Interpolants.DynamicParameter0;
#endif	//USE_DYNAMIC_PARAMETERS

#if LIGHTMAP_UV_ACCESS
	Result.LightmapUVs = 1;
#endif

	Result.TwoSidedSign = 1;

	return Result;
}

#if NEEDS_LIGHTMAP_COORDINATE
float2 GetLightMapCoordinate(FVertexFactoryInterpolantsVSToPS Interpolants)
{
	return Interpolants.LightMapCoordinate;
}
#endif

////////////////////////////////////////////////////////////////////////
// BufferLoad - translate an index into uvs to load the value from a texture containing the array values.
float4 BufferLoad(sampler InBuffer, float InIndex, float2 InBufferDims)
{
	float4 TCs;
	TCs.x = frac(InIndex / InBufferDims.x)+ (0.5f / InBufferDims.x);
	TCs.y = (floor(InIndex / InBufferDims.x) + 0.5f)/ InBufferDims.y;
	TCs.zw = float2(0, 0);

	return tex2Dlod(InBuffer, TCs);
}

float4 BufferLoad(sampler InBuffer, float2 TCs)
{
	return tex2Dlod(InBuffer, float4(TCs,0,0));
}

FInstancedVertexFactoryInput GetInstancedVertexFactoryInput(FVertexFactoryInput Input)
{
	FInstancedVertexFactoryInput Result;


	// Read the 2d scale, 2d rotation, and sub-uv index from the scale and rotation data sampler.
	float4 scaleRotation = BufferLoad(VTFInstanceScaleAndRotationDataSampler,Input.TexCoord.zw);
	// Here is where we read attributes from textrue rather than use passed in attributes and they would get compiled out.
	float4 posIndex = BufferLoad(VTFInstancePositionDataSampler,Input.TexCoord.zw) * float4(50,50,50,1);
	Result.InstancePosition = posIndex.xyz;

#if NUM_MATERIAL_TEXCOORDS
	int index;
	float subUV = scaleRotation.w;
	float remain = modf( subUV, index );
	index = index % MAX_SUBUV;
	Result.TexCoord.x = (Input.TexCoord.x*ScaleXSubUV)+SubUVTable[index].x;
	Result.TexCoord.y = (Input.TexCoord.y*ScaleYSubUV)+SubUVTable[index].y;

#if SUBUV_PARTICLES
	Result.TexCoord.z = (Input.TexCoord.x*ScaleXSubUV)+SubUVTable[index].z;
	Result.TexCoord.w = (Input.TexCoord.y*ScaleYSubUV)+SubUVTable[index].w;
	Result.Interp_Sizer = remain*BlendSubUV;
#endif

#endif

	Result.InstanceVertexColor = BufferLoad(VTFInstanceColorDataSampler,Input.TexCoord.zw);

	Result.TangentX = float3(255,0,0);
	Result.TangentZ = float4(0,0,255,1);

    float3 pos =  (MulMatrix(View, float4(posIndex.xyz,1))).xyz; // put the camera in view space

	float rcos = cos(scaleRotation.z);	// compute R cos-theta
	float rsin = sin(scaleRotation.z);	// compute R sin-theta

	// 2d rotation
#if ROTATE_BEFORE_SCALE
	float rx = (rcos*Input.Position.x - rsin*Input.Position.y)*scaleRotation.x;
	float ry = (rsin*Input.Position.x + rcos*Input.Position.y)*scaleRotation.y;
#else
	float scaledX = Input.Position.x * scaleRotation.x;
	float scaledY = Input.Position.y * scaleRotation.y;
	
	float rx = (rcos*scaledX - rsin*scaledY);
	float ry = (rsin*scaledX + rcos*scaledY);
#endif

	Result.Position = float4(pos.x+rx,pos.y+ry,pos.z,1);

	//now we need to transform this back to world space, because there is probably some other shader that is transforming this value by the viewProjection matrix
    Result.Position = MulMatrix(InvView,float4(Result.Position.xyz,1));


#if NEEDS_VERTEX_LIGHTMAP
	Result.LightMapA = Input.LightMapA;
	Result.LightMapB = Input.LightMapB;
	Result.LightMapC = Input.LightMapC;
#elif NEEDS_SIMPLE_VERTEX_LIGHTMAP
	Result.LightMapA = Input.LightMapA;
#endif
#if NEEDS_LIGHTMAP_COORDINATE
	Result.LightMapCoordinate = Input.LightMapCoordinate;
#endif

	return Result;
}

float4x4 GetInstanceToWorld(FVertexFactoryInput Input)
{
	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);
	return transpose(
			float4x4(
				float4(1,0,0,0),
				float4(0,1,0,0),
				float4(0,0,1,0),
				float4(InstancedInput.InstancePosition,1)
			));
}

#if NEEDS_LIGHTMAP_COORDINATE
float2 GetInstanceLightMapCoordinate(FVertexFactoryInput Input)
{
	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);
	return InstancedInput.LightMapCoordinate;
}
#endif

#if NEEDS_VERTEX_LIGHTMAP
void VertexFactoryGetVertexLightMap(FVertexFactoryInput Input,out float4 LightMapA,out float4 LightMapB,out float4 LightMapC)
{
	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);
	LightMapA = InstancedInput.LightMapA;
	LightMapB = InstancedInput.LightMapB;
	LightMapC = InstancedInput.LightMapC;
}
#elif NEEDS_SIMPLE_VERTEX_LIGHTMAP
void VertexFactoryGetSimpleVertexLightMap(FVertexFactoryInput Input,out float4 LightMapA)
{
	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);
	LightMapA = InstancedInput.LightMapA;
}
#endif

float3 VectorLocalToWorld(FVertexFactoryInput Input,float3 LocalVector)
{
	return mul(GetInstanceToWorld(Input),float4(LocalVector,0)).xyz;
}

float4 CalcWorldPosition(FVertexFactoryInput Input)
{
	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);

	// $$ the only thing we do for isntancing is translate since our geometry is camera facing sprites.
	float4 instancedWorldPos = float4(InstancedInput.Position.xyz,1);  //float4(InstancedInput.Position.xyz + InstancedInput.InstancePosition.xyz,1);

	// final mul removes unreal's odd camera translation.  If we don't the particle system will stay fixed relative to the camera rather than the world
	return MulMatrix(LocalToWorld,instancedWorldPos);
}

/**
* Get the 3x3 tangent basis vectors for this vertex factory
* this vertex factory will calculate the binormal on-the-fly
*
* @param Input - vertex input stream structure
* @return 3x3 matrix
*/
float3x3 VertexFactoryGetTangentBasis( FVertexFactoryInput Input,FVertexFactoryIntermediates Intermediates)
{
	float3x3 Result=0;

	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);

	half4 TangentZ = TangentBias(InstancedInput.TangentZ);
	// pass-thru the tangent
	Result[0] = TangentBias(InstancedInput.TangentX);
	// pass-thru the normal
	Result[2] = float3(TangentZ.x,TangentZ.y,TangentZ.z);
	// derive the binormal by getting the cross product of the normal and tangent
	Result[1] = cross(Result[2], Result[0]) * TangentZ.w;

	return Result;
}

/**
* Get the 3x3 tangent basis vectors for this vertex factory
* this vertex factory will calculate the binormal on-the-fly
*
* @param Input - vertex input stream structure
* @return 3x3 matrix
*/
float3x3 VertexFactoryGetTangentBasisInternal( FVertexFactoryInput Input)
{
	float3x3 Result=0;

	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);

	half4 TangentZ = TangentBias(InstancedInput.TangentZ);
	// pass-thru the tangent
	Result[0] = TangentBias(InstancedInput.TangentX);
	// pass-thru the normal
	Result[2] = float3(TangentZ.x,TangentZ.y,TangentZ.z);
	// derive the binormal by getting the cross product of the normal and tangent
	Result[1] = cross(Result[2], Result[0]) * TangentZ.w;

	return Result;
}


float4 VertexFactoryGetWorldPosition(FVertexFactoryInput Input,FVertexFactoryIntermediates Intermediates)
{
	return CalcWorldPosition(Input);
}

FVertexFactoryInterpolantsVSToPS VertexFactoryGetInterpolantsVSToPS(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	FVertexFactoryInterpolantsVSToPS Interpolants;
	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);

#if NUM_MATERIAL_TEXCOORDS
	#if SUBUV_PARTICLES
	float	interpSize = InstancedInput.Interp_Sizer.w;
	#else
	float	interpSize = 0;
	#endif
#else
	float	interpSize = 0;
#endif



#if NUM_MATERIAL_TEXCOORDS
	// Ensure the unused components of the last packed texture coordinate are initialized.
	Interpolants.TexCoord = 0;

	UNROLL
	for(int CoordinateIndex = 0;CoordinateIndex < NUM_MATERIAL_TEXCOORDS;CoordinateIndex += 2)
	{
		Interpolants.TexCoord = InstancedInput.TexCoord;
		if(CoordinateIndex + 1 < NUM_MATERIAL_TEXCOORDS)
		{
			Interpolants.TexCoord = InstancedInput.TexCoord;
		}
	}

#if SUBUV_PARTICLES
#if !WORLD_COORDS
	Interpolants.Interp_Sizer = interpSize;
#endif
#endif

#endif


#if NEEDS_LIGHTMAP_COORDINATE
	Interpolants.LightMapCoordinate = GetInstanceLightMapCoordinate(Input) * ShadowCoordinateScaleBias.xy + ShadowCoordinateScaleBias.wz;
#endif

#if WORLD_COORDS
		float3x3 LocalToTangent = VertexFactoryGetTangentBasisInternal(Input);
		// The inverse of LocalToTangent is just the transpose because it is an orthonormal basis
		float3x3 TangentToLocal = transpose(LocalToTangent);

		// Calculate the transform from tangent to world space
		float4x4 InstanceToWorld = GetInstanceToWorld(Input);
		#if PS3
			float3x3 TangentToWorld = mul(transpose((float3x3)InstanceToWorld), TangentToLocal);
		#else
			float3x3 TangentToWorld = mul((float3x3)InstanceToWorld, TangentToLocal);
		#endif

		Interpolants.TangentToWorld0 = float4(TangentToWorld[0],interpSize);
		Interpolants.TangentToWorld2 = float4(TangentToWorld[2], TangentBias(InstancedInput.TangentZ.w));
#endif

#if !COMPILER_SUPPORTS_EMPTY_STRUCTS && !WORLD_COORDS && !NEEDS_LIGHTMAP_COORDINATE && !NUM_MATERIAL_TEXCOORDS
	Interpolants.Dummy = float4(0,0,0,0);
#endif

	Interpolants.InterpolantVertexColor = InstancedInput.InstanceVertexColor;

	return Interpolants;
}

half3 VertexFactoryGetWorldNormal(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	FInstancedVertexFactoryInput InstancedInput = GetInstancedVertexFactoryInput(Input);
	return VectorLocalToWorld(Input, TangentBias(InstancedInput.TangentZ.xyz));
}

float4 VertexFactoryGetPreviousWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return CalcWorldPosition(Input);
}

/**
* Transform a vector from world space to tangent space
*
* @param Input - vertex input stream structure
* @param TangentBasis - 3x3 matrix to transform to tangent space
* @param WorldVector - vector in world space to transform
* @return vector in tangent space
*/
float3 VertexFactoryWorldToTangentSpace( FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float3x3 TangentBasis, float3 WorldVector )
{
	// we use a straight mul here because we are generating the matrix, so we don't worry about column major vs row major (which is what MulMatrix manages per-platform)
	return mul(
		TangentBasis,
		mul(float4(WorldVector,0),GetInstanceToWorld(Input)).xyz
		);
}


FVertexFactoryIntermediates GetVertexFactoryIntermediates(FVertexFactoryInput Input)
{
	FVertexFactoryIntermediates Intermediates;
	Intermediates.Dummy = 0;
	return Intermediates;
}

float4 VertexFactoryGetVertexColor(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
	return 1;
}

/** Converts from vertex factory specific input to a FMaterialVertexParameters, which is used by vertex shader material inputs. */
FMaterialVertexParameters GetMaterialVertexParameters( FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float3 WorldPosition, float3x3 TangentBasis )
{
	FMaterialVertexParameters Result;
	Result.WorldPosition = WorldPosition - PreViewTranslation.xyz;
	Result.VertexColor = VertexFactoryGetVertexColor(Input, Intermediates);
	float3x3 TangentToLocal = transpose(TangentBasis);

	#if PS3
		float3x3 TangentToWorld = mul(transpose((float3x3)LocalToWorld), TangentToLocal); 
	#else
		// does not handle instancing!
		float3x3 TangentToWorld = mul((float3x3)LocalToWorld, TangentToLocal); 
	#endif

	Result.TangentToWorld = TangentToWorld;
#if NUM_MATERIAL_TEXCOORDS && !(DECAL_FACTORY && MATERIAL_DECAL)
	for(int CoordinateIndex = 0; CoordinateIndex < NUM_MATERIAL_TEXCOORDS; CoordinateIndex++)
	{
#if XBOX
		// TexCoords for the vertex shader instanced meshes on XBox360 are not implemented.
		Result.TexCoords[CoordinateIndex] = 0.0f;
#else
		Result.TexCoords[CoordinateIndex] = Input.TexCoord;
#endif
	}
#endif
	return Result;
}
