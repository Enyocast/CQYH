//--------------------------------------------------------------------------------------
// Water shaders
//--------------------------------------------------------------------------------------

[domain("quad")]
PSIn_Diffuse MainDomain(    PatchData input, 
                                    float2 uv : SV_DomainLocation,
                                    OutputPatch<DUMMY, 1> inputPatch )
{
    PSIn_Diffuse output;
	float3 vertexPosition;
	float2 texcoord0to1 = (input.origin.xy + uv * input.size) / g_HeightFieldSize;
	float4 water_normal;
	float4 depthmap_scaler;

	// getting rough estimate of water depth from depth map texture 
	depthmap_scaler = g_DepthMapTexture.SampleLevel( SamplerLinearWrap, float2(texcoord0to1.x, 1 - texcoord0to1.y), 0);
	
	output.layerdef = depthmap_scaler;

	depthmap_scaler = float4( 1, 1, 1, 1 );

	// calculating water surface geometry position and normal
	vertexPosition.xy = input.origin.xy + uv * input.size;


	vertexPosition.z  = input.origin.z - g_WaterHeightBumpScale / 2;

	water_normal = CombineWaterNormal(vertexPosition.xyz);

	output.layerdef = water_normal;

	// fading out displacement and normal disturbance near shores by 60%
	//water_normal.xyz = lerp( float3(0,0,1), normalize(water_normal.xyz), 0.4 + 0.6 * depthmap_scaler.b);	
	vertexPosition.z += water_normal.w * g_WaterHeightBumpScale;// * (0.4 + 0.6 * depthmap_scaler.b);
	vertexPosition.xy -= float2(water_normal.x, water_normal.y) * 0.5;// * (0.4 + 0.6 * depthmap_scaler.b);

	//output.positionRaw.xy = vertexPosition.xy;
	//output.positionRaw.z = max(0, vertexPosition.z);

	//float4 posWS = mul( LocalToWorld, float4(vertexPosition, 1.0) );
	float4 posWS = float4( vertexPosition, 1.0 );

	// writing output params
    output.position = mul( g_ModelViewProjectionMatrix, posWS);
    output.texcoord = texcoord0to1 * g_WaterMicroBumpTexcoordScale + g_WaterBumpTexcoordShift * 0.07;
	output.normal = normalize(water_normal.xyz);
	output.depthmap_scaler = depthmap_scaler;
	output.positionWS = posWS.xyz;
	output.positionLS = vertexPosition - input.origin;
	//output.positionWS.z = max(0, vertexPosition.z);
	//output.layerdef = float4(texcoord0to1.xy, 0, 0);
    return output;
}

float3 ClampToZero(float3 v)
{
	float3 r;
	r.x = max(0, v.x);
	r.y = max(0, v.y);
	r.z = max(0, v.z);
	return r;
}

PSIn_Diffuse MainVertexShader_NoTess( float3 PatchParams : POSITION )
{
    PSIn_Diffuse output;
	float3 vertexPosition = mul( LocalToWorld, float4(PatchParams.xyz, 1.0 ) ).xyz;
	float2 texcoord0to1 = vertexPosition.xy / g_HeightFieldSize;
	float4 water_normal;
	float4 depthmap_scaler;

	// getting rough estimate of water depth from depth map texture
	depthmap_scaler = float4( 1, 1, 1, 1 );

	vertexPosition.z -= g_WaterHeightBumpScale / 2;

	water_normal = CombineWaterNormal(vertexPosition);

	output.layerdef = water_normal;

	// fading out displacement and normal disturbance near shores by 60%
	//water_normal.xyz = lerp( float3(0,0,1), normalize(water_normal.xyz), 0.4 + 0.6 * depthmap_scaler.b);	
	vertexPosition.z += water_normal.w * g_WaterHeightBumpScale;// * (0.4 + 0.6 * depthmap_scaler.b);
	vertexPosition.xy -= float2(water_normal.x, water_normal.y) * 0.5;// * (0.4 + 0.6 * depthmap_scaler.b);

	//output.positionRaw.xy = vertexPosition.xy;
	//output.positionRaw.z = max(0, vertexPosition.z);

	//float4 posWS = mul( LocalToWorld, float4(vertexPosition, 1.0) );
	float4 posWS = float4( vertexPosition, 1.0 );

	// writing output params
    output.position = mul( g_ModelViewProjectionMatrix, posWS);
    output.texcoord = texcoord0to1 * g_WaterMicroBumpTexcoordScale + g_WaterBumpTexcoordShift * 0.07;
	output.normal = normalize(water_normal.xyz);
	output.depthmap_scaler = depthmap_scaler;
	output.positionWS = posWS.xyz;
	output.positionLS = vertexPosition - PatchParams.xyz;
	//output.positionWS.z = max(0, vertexPosition.z);
	//output.layerdef = float4(texcoord0to1.xy, 0, 0);
    return output;
}

float4 MainPixelShader(PSIn_Diffuse input) : SV_Target
{
	float4 color={0,0,0,0};
	float3 pixel_to_light_vector = normalize(g_LightPosition - input.positionWS);
	float3 pixel_to_eye_vector = normalize(g_CameraPosition - input.positionWS);
	float3 reflected_eye_to_pixel_vector={0,0,0};
	float3 microbump_normal; 
	float3x3 normal_rotation_matrix;

	float fresnel_factor = 0;
	float diffuse_factor = 0;
	float specular_factor = 0;
	float scatter_factor = 0;
	float4 refraction_color={0,0,0,0};
	float4 reflection_color={0,0,0,0};
	float4 disturbance_eyespace={0,0,0,0};

	float water_depth = 0;
	float4 water_color={0,0,0,0};

	float distToCamera = length( g_CameraPosition - input.positionWS);

	// calculating pixel position in light space
	/*float4 positionLS = mul( g_LightModelViewProjectionMatrix, float4(input.positionWS,1) );
	positionLS.xyz /= positionLS.w;
	positionLS.x = (positionLS.x + 1) * 0.5;
	positionLS.y = (1 - positionLS.y) * 0.5;*/

	// calculating shadow multiplier to be applied to diffuse/scatter/specular light components
	//float dsf = 1.0f / 4096.0f;
	//float shadow_factor = 1.0;
	//shadow_factor  = 0.2 * g_DepthTexture.SampleCmp(SamplerDepthAnisotropic, positionLS.xy, positionLS.y * 0.995f).r;
	//shadow_factor += 0.2 * g_DepthTexture.SampleCmp(SamplerDepthAnisotropic,positionLS.xy+float2(dsf,dsf),positionLS.y* 0.995f).r;
	//shadow_factor += 0.2 * g_DepthTexture.SampleCmp(SamplerDepthAnisotropic,positionLS.xy+float2(-dsf,dsf),positionLS.y* 0.995f).r;
	//shadow_factor += 0.2 * g_DepthTexture.SampleCmp(SamplerDepthAnisotropic,positionLS.xy+float2(dsf,-dsf),positionLS.y* 0.995f).r;
	//shadow_factor += 0.2 * g_DepthTexture.SampleCmp(SamplerDepthAnisotropic,positionLS.xy+float2(-dsf,-dsf),positionLS.y* 0.995f).r;

	// need more high frequency bumps for plausible water surface, so creating normal defined by 2 instances of same bump texture
	microbump_normal = normalize(2.0*g_WaterBumpTexture.Sample(SamplerAnisotropicWrap,input.texcoord-g_WaterBumpTexcoordShift*0.2).grb - float3(1,1,-8));
	microbump_normal+= normalize(2.0*g_WaterBumpTexture.Sample(SamplerAnisotropicWrap,input.texcoord*0.5+g_WaterBumpTexcoordShift*0.05).grb - float3(1,1,-8));
	//microbump_normal = normalize(g_WaterBumpTexture.Sample(SamplerAnisotropicWrap,input.texcoord-g_WaterBumpTexcoordShift*0.2).grb + float3(0,0,8));
	//microbump_normal+= normalize(g_WaterBumpTexture.Sample(SamplerAnisotropicWrap,input.texcoord*0.5+g_WaterBumpTexcoordShift*0.05).grb + float3(0,0,8));

	//float4 dptc = g_DepthMapTexture.SampleLevel( SamplerLinearWrap, input.texcoord, 0);
	//return input.layerdef;
	//return float4(input.normal.xyz, 0);
	// calculating base normal rotation matrix
	//normal_rotation_matrix[2]=input.normal.xyz;
	//normal_rotation_matrix[0]=normalize(cross(float3(0.0,-1.0,0.0),normal_rotation_matrix[2]));
	//normal_rotation_matrix[1]=normalize(cross(normal_rotation_matrix[0],normal_rotation_matrix[2]));

	normal_rotation_matrix[2]=input.normal.xyz;
	normal_rotation_matrix[0]=normalize(cross(float3(1.0,0.0,0.0),normal_rotation_matrix[2]));
	normal_rotation_matrix[1]=normalize(cross(normal_rotation_matrix[2],normal_rotation_matrix[0]));

	// applying base normal rotation matrix to high frequency bump normal
	microbump_normal=mul(normalize(microbump_normal), normal_rotation_matrix);
	
	// simulating scattering/double refraction: light hits the side of wave, travels some distance in water, and leaves wave on the other side
	// it's difficult to do it physically correct without photon mapping/ray tracing, so using simple but plausible emulation below
	
	// only the crests of water waves generate double refracted light
	scatter_factor = 2.5 * max(0, input.positionLS.z * 0.00125 + 0.25);
	
	// the waves that lie between camera and light projection on water plane generate maximal amount of double refracted light 
	float viewcos = dot(normalize(float3(
		pixel_to_light_vector.x,
		pixel_to_light_vector.y,
		0.0)), -pixel_to_eye_vector);

	scatter_factor *= /*shadow_factor * */pow(max(0.0, viewcos),2.0);
	
	// the slopes of waves that are oriented back to light generate maximal amount of double refracted light 
	scatter_factor *= pow(max(0.0, 1.0 - dot(pixel_to_light_vector, microbump_normal)), g_WaterScatterColorPower);
	
	// water crests gather more light than lobes, so more light is scattered under the crests
  	scatter_factor += /*shadow_factor * */1.5 * g_WaterColorIntensity.y * max(0, input.positionLS.z + 200)
  		// the scattered light is best seen if observing direction is normal to slope surface
  		* max(0, dot(pixel_to_eye_vector, microbump_normal))
  		// fading scattered light out at distance and if viewing direction is vertical to avoid unnatural look
  		* max(0, -pixel_to_eye_vector.z) * (15000.0 / (15000.0 + distToCamera));

	// fading scatter out by 90% near shores so it looks better
	//scatter_factor*=0.1+0.9*input.depthmap_scaler.g;


	// calculating fresnel factor 
	float r = (1.2 - 1.0) / (1.2 + 1.0);
	fresnel_factor = max(
		0.0, 
		min(1.0, r + (1.0 - r) * pow(1.0 - dot(microbump_normal, pixel_to_eye_vector), 4)));

	// calculating specular factor
	reflected_eye_to_pixel_vector = -reflect(pixel_to_eye_vector, microbump_normal);
	//reflected_eye_to_pixel_vector = -pixel_to_eye_vector + 2 * dot(dotpixel_to_eye_vector, microbump_normal) * microbump_normal;
	specular_factor = /*shadow_factor * */fresnel_factor * 0.5;
	specular_factor *= pow(max(0, dot(pixel_to_light_vector, reflected_eye_to_pixel_vector)), g_WaterSpecularPower);

	// calculating diffuse intensity of water surface itself
	diffuse_factor = g_WaterColorIntensity.x + g_WaterColorIntensity.y * max(0,dot(pixel_to_light_vector,microbump_normal));
	
	// calculating disturbance which has to be applied to planar reflections/refractions to give plausible results
	//disturbance_eyespace = mul( g_ModelViewMatrix, float4(microbump_normal.x, microbump_normal.y, microbump_normal.z, 0));
	disturbance_eyespace = mul(g_ModelViewMatrix, float4(microbump_normal.x, microbump_normal.y, 0,0));

	float2 reflection_disturbance = float2(disturbance_eyespace.x, disturbance_eyespace.y) * 0.06;
	float2 refraction_disturbance = float2(-disturbance_eyespace.x, disturbance_eyespace.z)* 0.05 *
		// fading out reflection disturbance at distance so reflection doesn't look noisy at distance
		(1000.0 / (1000.0 + distToCamera));
	
	// calculating correction that shifts reflection up/down according to water wave Y position
	float4 projected_waveheight = mul(g_ModelViewProjectionMatrix, float4(input.positionWS.x,input.positionWS.y, input.positionWS.z,1));
	float waveheight_correction = -0.5 * projected_waveheight.y / projected_waveheight.w;
	projected_waveheight = mul(g_ModelViewProjectionMatrix, float4(input.positionWS.x, input.positionWS.y, input.positionWS.z-80.0, 1));
	waveheight_correction += 0.5 * projected_waveheight.y / projected_waveheight.w;
	reflection_disturbance.y = max(-0.15, waveheight_correction + reflection_disturbance.y);

	// picking refraction depth at non-displaced point, need it to scale the refraction texture displacement amount according to water depth
	float refraction_depth = GetRefractionDepth( input.position.xy * g_ScreenSizeInv);
	//refraction_depth = g_ZFar * g_ZNear / (g_ZFar - refraction_depth *(g_ZFar - g_ZNear));
	refraction_depth = g_ZNear * ( 1.0 - Z_PRECISION ) / ( 1.0 - Z_PRECISION - refraction_depth );
	float4 vertex_in_viewspace = mul( g_ModelViewMatrix, float4(input.positionWS, 1));
	water_depth = refraction_depth - vertex_in_viewspace.z;
/*	float nondisplaced_water_depth = water_depth;
	
	// scaling refraction texture displacement amount according to water depth, with some limit
	//refraction_disturbance *= min(2, water_depth);

	// picking refraction depth again, now at displaced point, need it to calculate correct water depth
	refraction_depth = GetRefractionDepth(input.position.xy * g_ScreenSizeInv + refraction_disturbance);
	//refraction_depth = g_ZFar * g_ZNear / (g_ZFar - refraction_depth * (g_ZFar - g_ZNear));
	refraction_depth = g_ZNear * ( 1.0 - Z_PRECISION ) / ( 1.0 - Z_PRECISION - refraction_depth );
	//vertex_in_viewspace = mul( g_ModelViewMatrix, float4(input.positionWS, 1) );
	water_depth = refraction_depth - vertex_in_viewspace.z;


	// zeroing displacement for points where displaced position points at geometry which is actually closer to the camera than the water surface
	float conservative_refraction_depth = GetConservativeRefractionDepth(input.position.xy * g_ScreenSizeInv + refraction_disturbance);
	//conservative_refraction_depth = g_ZFar * g_ZNear / (g_ZFar - conservative_refraction_depth * (g_ZFar - g_ZNear));
	conservative_refraction_depth = g_ZNear * ( 1.0 - Z_PRECISION ) / ( 1.0 - Z_PRECISION - conservative_refraction_depth );
	//vertex_in_viewspace = mul(g_ModelViewMatrix, float4(input.positionWS, 1));
	float conservative_water_depth = conservative_refraction_depth - vertex_in_viewspace.z;

	if(conservative_water_depth < 0)
	{
		refraction_disturbance = 0;
		water_depth = nondisplaced_water_depth;
	}
	water_depth = max(0, water_depth);
	
*/
	//return water_depth;

	float2 reflectUV = float2(input.position.x * g_ScreenSizeInv.x, input.position.y * g_ScreenSizeInv.y) + reflection_disturbance;
	// getting reflection and refraction color at disturbed texture coordinates
	// fix the green bord issue
	reflectUV.x = clamp( reflectUV.x, 0.005, 0.985 );
	//reflectUV.y = clamp( reflectUV.y, 0.005, 0.97 );
	reflection_color = g_ReflectionTexture.SampleLevel(SamplerLinearClamp, reflectUV, 0) * g_ReflectionIntensity;

	float2 refractUV = input.position.xy * g_ScreenSizeInv + refraction_disturbance;
	refraction_color = g_RefractionTexture.SampleLevel(SamplerLinearClamp, refractUV,0);

	// calculating water surface color
	water_color = diffuse_factor * float4(g_WaterDeepColor, 1);

	// fading fresnel factor to 0 to soften water surface edges
	fresnel_factor *= min(1, water_depth * 0.02);

	// fading refraction color to water color according to distance that refracted ray travels in water 
	refraction_color = lerp(water_color, refraction_color, min(1, 1.0 * exp(-water_depth / 150.0)));
	//refraction_color = water_color * 0.8 + refraction_color * 0.2;

	// combining final water color
	color.rgb = lerp(refraction_color.rgb, reflection_color.rgb, fresnel_factor);
	color.rgb += g_WaterSpecularIntensity * specular_factor * g_WaterSpecularColor * (1.0 - fresnel_factor);
	color.rgb += g_WaterScatterColor * scatter_factor * g_WaterScatterColorIntensity;
	
	// apply fog
	float fogFactor = min(1,exp(-distToCamera*g_FogDensity));
	float3 fogColor = CalculateFogColor(pixel_to_light_vector,pixel_to_eye_vector);
	color.rgb = lerp( fogColor, color.rgb, fogFactor );

	// add foam
	//float4 foamClr = g_FoamTexture.SampleLevel(SamplerLinearWrap, input.texcoord, 0);	
	//float4 foamClr = float4( 0.5, 0.5, 0.6, 1.0 );
	//color.rgb  += foamClr.rgb * ( 1.0 - min( 1.0, water_depth * 0.01 ) );

	//color.rgb = 0.2 / 2.2;
	//color.rgb = float3( 0, 0, 1 );
	//color.rgb = float3( input.texcoord, 0.f );
	//color.rgb = 0.5 * ( input.normal.xyz + float3( 1.0, 1.0, 1.0 ) );
	//color.rgb = pixel_to_eye_vector.xyz;
	//color.rgb = reflectCubeClr.rgb;
	//color.rgb = pixel_to_light_vector.rgb;
	//color.rgb = pixel_to_eye_vector.rgb;
	//color.rgb = reflected_eye_to_pixel_vector.rgb;
	//color.rgb = 0.5 * ( microbump_normal.xyz + float3( 1.0, 1.0, 1.0 ) );
	//color.rgb = g_WaterSpecularIntensity * specular_factor * g_WaterSpecularColor * fresnel_factor;
	//color.rgb = water_color;
	//color.rgb = refraction_color.rgb;
	//color.rgb = reflection_color.rgb;
	//color.rgb = disturbance_eyespace.rgb;
	//color.rgb = water_color.rgb;
	//color.rgb = refraction_depth / 1000.0;
	//color.rgb = vertex_in_viewspace.z / 10000.0;
	//color.rgb = water_depth / 1000.0;
	//color.rgb = fresnel_factor;
	//color.rgb = scatter_factor;
	//color.rgb = specular_factor;
	//color.rgb = g_RefractionDepthTextureResolved.SampleLevel(SamplerLinearClamp, refractUV,0).r;
	//color.rgb = g_AtmosphereBrightColor.rgb;
	//color.rgb = input.positionLS.z / 500.0;

	color.a = 1;
	return color;
}