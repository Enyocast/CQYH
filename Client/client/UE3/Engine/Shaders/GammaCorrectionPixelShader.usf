	Copyright 1998-2013 Epic Games, Inc. All Rights Reserved.
=============================================================================*/

#include "Common.usf"

half3 ColorScale;
half4 OverlayColor;
half InverseGamma;

void Main(
	in float2 UV : TEXCOORD0,
	out float4 OutColor : COLOR0
	)
{
	half4 SceneColor = FixupSceneColor(tex2D(SceneColorTexture,UV));

	half3 LinearColor = lerp( SceneColor.rgb * ColorScale,OverlayColor.rgb,OverlayColor.a);
	// RETURN_COLOR not needed unless writing to SceneColor

	float3 GammaColor = pow(saturate(LinearColor),InverseGamma);

	// [ming@snda
#if OUTPUT_LUM_IN_ALPHACHANNEL
	// alpha channel setup is only needed if FXAA/MLAA is used (can be optimized)
	half Luma = dot(GammaColor, float3(0.299f, 0.587f, 0.114f));

	OutColor = float4(GammaColor,Luma);
#else
	OutColor = float4(GammaColor,SceneColor.a);
#endif
	// ming@snda]
}
