#if ONLY_VS_PS

struct FVertexFactoryInput
{
	float3	Position	: POSITION;
};

float4x4 LocalToWorld;
float4x4 ViewProjectionMatrix;

struct FWaterVSToPS
{
	float4 Position : POSITION;
	float2 UV : TEXCOORD0;
};
#define FVertexOutput	FWaterVSToPS

void MainVertexShader(
	in FVertexFactoryInput	Input,
	out FVertexOutput Output )
{
		float3 ScreenPosition = mul( LocalToWorld, Input.Position );
		Output.Position = mul( ViewProjectionMatrix, float4(ScreenPosition.xyz, 1) );
		Output.UV = 0;//Input.UV;
}

void MainVertexShader_NoTess(
	in FVertexFactoryInput	Input,
	out FVertexOutput Output )
{
		float3 ScreenPosition = mul( LocalToWorld, Input.Position );
		Output.Position = mul( ViewProjectionMatrix, float4(ScreenPosition.xyz, 1) );
		Output.UV = 0;//Input.UV;
}

void MainPixelShader(
	in FVertexOutput Input,
	out float4 OutColor	: COLOR0 )
{
	float3 clr = g_WaterDeepColor.xyz * sin(g_GameTime);
	OutColor = float4( clr, 1 );
}

